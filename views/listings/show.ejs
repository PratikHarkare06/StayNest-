<%- layout("/layouts/boilerplate") %>

<style>
/* ── Photo Grid ─────────────────────────────────────────────── */
.photo-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 8px;
  height: 480px;
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 2rem;
}

.photo-grid-item {
  overflow: hidden;
  cursor: pointer;
  position: relative;
  background: #e5e5e5;
}

.photo-grid-item:first-child {
  grid-row: 1 / 3;
}

.photo-grid-item img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.photo-grid-item:hover img { transform: scale(1.04); }

.show-all-photos-btn {
  position: absolute;
  bottom: 1rem; right: 1rem;
  background: white;
  border: 1px solid #222;
  border-radius: 8px;
  padding: 0.5rem 1rem;
  font-weight: 600;
  font-size: 0.85rem;
  cursor: pointer;
  transition: background 0.2s;
  z-index: 10;
}
.show-all-photos-btn:hover { background: #f7f7f7; }

@media (max-width: 768px) {
  .photo-grid {
    grid-template-columns: 1fr;
    grid-template-rows: 280px;
    height: 280px;
  }
  .photo-grid-item:not(:first-child) { display: none; }
}

/* ── Lightbox ────────────────────────────────────────────────── */
#lightbox {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.96);
  z-index: 9999;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
#lightbox.active { display: flex; }

#lightbox-img {
  max-width: 90vw;
  max-height: 80vh;
  object-fit: contain;
  border-radius: 8px;
  transition: opacity 0.2s;
}

.lightbox-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: white;
  border: none;
  border-radius: 50%;
  width: 48px; height: 48px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  opacity: 0.9;
  transition: opacity 0.2s, transform 0.2s;
  z-index: 2;
}
.lightbox-nav:hover { opacity: 1; transform: translateY(-50%) scale(1.05); }
.lightbox-prev { left: 1.5rem; }
.lightbox-next { right: 1.5rem; }

.lightbox-close {
  position: absolute;
  top: 1.25rem; left: 1.25rem;
  background: none;
  border: none;
  color: white;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: 8px;
  transition: background 0.2s;
}
.lightbox-close:hover { background: rgba(255,255,255,0.1); }

.lightbox-counter {
  position: absolute;
  top: 1.25rem; left: 50%; transform: translateX(-50%);
  color: white;
  font-weight: 600;
  font-size: 0.9rem;
}

.lightbox-thumbs {
  position: absolute;
  bottom: 1.5rem;
  display: flex;
  gap: 8px;
}

.lightbox-thumb {
  width: 60px; height: 44px;
  object-fit: cover;
  border-radius: 6px;
  cursor: pointer;
  opacity: 0.5;
  border: 2px solid transparent;
  transition: opacity 0.2s, border-color 0.2s;
}
.lightbox-thumb.active { opacity: 1; border-color: white; }

/* ── Host Card ───────────────────────────────────────────────── */
.host-card {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
  padding: 1.75rem 0;
  border-top: 1px solid #ebebeb;
  border-bottom: 1px solid #ebebeb;
  margin-bottom: 2rem;
}

.host-avatar-wrap { position: relative; flex-shrink: 0; }

.host-avatar {
  width: 64px; height: 64px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #ebebeb;
}

.superhost-badge {
  position: absolute;
  bottom: -4px; left: 50%; transform: translateX(-50%);
  background: #222;
  color: white;
  font-size: 0.55rem;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 10px;
  white-space: nowrap;
  letter-spacing: 0.04em;
}

.host-stats {
  display: flex;
  gap: 1.5rem;
  margin-top: 0.75rem;
}

.host-stat { text-align: center; }
.host-stat-num { font-weight: 700; font-size: 1.1rem; }
.host-stat-label { font-size: 0.72rem; color: #717171; }

/* ── Booking Widget upgrades ─────────────────────────────────── */
.price-summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.95rem;
  margin-bottom: 0.75rem;
  color: #484848;
}

.price-summary-row.total {
  font-weight: 700;
  font-size: 1rem;
  border-top: 1px solid #ebebeb;
  padding-top: 0.75rem;
  margin-top: 0.5rem;
  color: #222;
}

/* ── Viewers badge ─────────────────────────────── */
.viewers-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: #fff8f0;
  border: 1px solid #fde0c4;
  border-radius: 20px;
  padding: 0.3rem 0.85rem;
  font-size: 0.8rem;
  font-weight: 600;
  color: #c45000;
  margin-bottom: 1rem;
}
/* Verified Pulse Animation */
@keyframes verify-pulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.2); opacity: 0.8; }
  100% { transform: scale(1); opacity: 1; }
}

.verify-pulse {
  animation: verify-pulse 2s infinite ease-in-out;
}

/* Trust Badges */
.trust-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.trust-badge-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.9rem;
  color: #222;
  font-weight: 500;
}

.trust-badge-item i {
  font-size: 1.25rem;
  color: #717171;
}
</style>

<!-- Lightbox -->
<div id="lightbox">
  <button class="lightbox-close" onclick="closeLightbox()">
    <i class="fa-solid fa-arrow-left"></i> Back to listing
  </button>
  <div class="lightbox-counter" id="lightbox-counter">1 / 5</div>
  <button class="lightbox-nav lightbox-prev" onclick="lightboxNav(-1)"><i class="fa-solid fa-chevron-left"></i></button>
  <img id="lightbox-img" src="" alt="photo">
  <button class="lightbox-nav lightbox-next" onclick="lightboxNav(1)"><i class="fa-solid fa-chevron-right"></i></button>
  <div class="lightbox-thumbs" id="lightbox-thumbs"></div>
</div>

    <div class="container mt-4 mb-5" data-listing-id="<%= listing._id %>">

        <!-- Page Title Row -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h1 class="fw-bold mb-0 fs-3"><%= listing.title %></h1>
          <div class="d-flex gap-2">
            <button class="btn btn-light rounded-pill px-3 hover-scale border-0" onclick="shareListing()" style="font-size:0.9rem;font-weight:600;">
              <i class="fa-solid fa-share-nodes me-2"></i>Share
            </button>
            <% if(currUser) { %>
            <form action="/users/wishlist/<%= listing._id %>" method="POST" class="d-inline wishlist-form">
              <button class="btn btn-light rounded-pill px-3 hover-scale border-0" style="font-size:0.9rem;font-weight:600;">
                <i class="<%= currUser.wishlist.some(id => id.toString() === listing._id.toString()) ? 'fa-solid text-danger' : 'fa-regular' %> fa-heart me-2"></i>Save
              </button>
            </form>
            <% } %>
          </div>
        </div>

        <% const avgRatingTop = listing.reviews && listing.reviews.length > 0
             ? (listing.reviews.reduce((s,r) => s + r.rating, 0) / listing.reviews.length).toFixed(1)
             : null; %>

        <% if (avgRatingTop) { %>
        <p class="text-dark mb-2" style="font-size:0.95rem;">
          <i class="fa-solid fa-star text-dark me-1"></i><strong><%= avgRatingTop %></strong>
          <span class="text-muted ms-1">· <%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %></span>
          <span class="text-muted mx-2">·</span>
          <span class="text-dark text-decoration-underline fw-semibold" style="cursor:pointer"><%= listing.location %>, <%= listing.country %></span>
        </p>
        <% } else { %>
        <p class="text-muted mb-2"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %></p>
        <% } %>

        <!-- Viewers Badge -->
        <div class="viewers-badge mb-3" id="viewers-badge" style="display:none;">
          <i class="fa-solid fa-fire"></i>
          <span id="viewers-count">0</span> people viewing right now
        </div>

        <!-- 5-Photo Grid Dynamic -->
        <div class="photo-grid position-relative" id="photo-grid">
          <% 
            // Build gallery array: primary first, then others
            let galleryUrls = [listing.image.url];
            if(listing.gallery && listing.gallery.length > 0) {
              listing.gallery.forEach(img => galleryUrls.push(img.url));
            }
            // Ensure we have at least 5 for the grid (repeat or placeholders)
            while(galleryUrls.length < 5) {
              galleryUrls.push(listing.image.url);
            }
          %>

          <% galleryUrls.slice(0, 5).forEach((url, index) => { %>
          <div class="photo-grid-item" data-index="<%= index %>">
            <img src="<%= url %>" alt="<%= listing.title %> – photo <%= index+1 %>" loading="<%= index === 0 ? 'eager' : 'lazy' %>">
          </div>
          <% }) %>

          <button class="show-all-photos-btn" onclick="openLightbox(0)">
            <i class="fa-regular fa-images me-2"></i>Show all <%= galleryUrls.length %> photos
          </button>
        </div>

        <div class="row">
            <!-- Main Content (Left) -->
            <div class="col-lg-8 pe-lg-5">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h1 class="fw-bold mb-2">
                            Stay at <%= listing.owner ? listing.owner.username : 'StayNest Host' %>'s place
                        </h1>
                        <p class="text-muted fs-5 mb-0">
                            <%= listing.maxGuests %> guests · 1 bedroom · 1 bed · 1 bath
                        </p>
                    </div>
                    <div class="host-badge">
                        <img src="<%= listing.owner.image && listing.owner.image.url ? listing.owner.image.url : '/images/default-user.jpg' %>" 
                             class="rounded-circle border" style="width: 56px; height: 56px; object-fit: cover;">
                    </div>
                </div>

                <hr class="my-4 opacity-10">

                <div class="host-experience-highlights">
                    <div class="d-flex gap-3 mb-4">
                        <div class="highlight-icon fs-4"><i class="fa-solid fa-door-open"></i></div>
                        <div>
                            <div class="fw-bold">Self check-in</div>
                            <div class="small text-muted">Check yourself in with the keypad.</div>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-4">
                        <div class="highlight-icon fs-4"><i class="fa-solid fa-medal"></i></div>
                        <div>
                            <div class="fw-bold"><%= listing.owner.username %> is a Superhost</div>
                            <div class="small text-muted">Superhosts are experienced, highly rated hosts.</div>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-4">
                        <div class="highlight-icon fs-4"><i class="fa-solid fa-calendar-days"></i></div>
                        <div>
                            <div class="fw-bold">Free cancellation for 48 hours</div>
                            <div class="small text-muted">Get a full refund if you change your mind.</div>
                        </div>
                    </div>
                </div>

                <hr class="my-4 opacity-10">

                <div class="d-flex align-items-center mb-4">
                    <div>
                        <p class="text-muted fs-5 mb-0">
                            <i class="fa-solid fa-location-dot text-danger me-2"></i>
                            <%= listing.location %>, <%= listing.country %>
                        </p>
                    </div>
                </div>

                <!-- Host Profile Card -->
                <div class="host-card">
                  <div class="host-avatar-wrap">
                    <% if (listing.owner.image && listing.owner.image.url) { %>
                      <img src="<%= listing.owner.image.url %>" class="host-avatar" alt="<%= listing.owner.username %>">
                    <% } else { %>
                      <div class="host-avatar bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="font-size:1.6rem;">
                        <%= listing.owner.username.charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                    <span class="superhost-badge">★ Superhost</span>
                  </div>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start">
                      <div>
                        <h5 class="fw-bold mb-0 d-flex align-items-center">
                            Hosted by <%= listing.owner.username %>
                            <i class="fa-solid fa-circle-check text-primary ms-2 verify-pulse" style="font-size: 0.8rem;" title="Verified Identity"></i>
                        </h5>
                        <p class="text-muted small mb-0">Member since <%= new Date(listing.owner._id.getTimestamp ? listing.owner._id.getTimestamp() : Date.now()).getFullYear() %></p>
                      </div>
                      <% if(currUser && !currUser._id.equals(listing.owner._id)) { %>
                        <a href="/messages/<%= listing.owner._id %>" class="btn btn-outline-dark rounded-pill fw-semibold btn-sm px-3">
                          <i class="fa-regular fa-comment-dots me-1"></i> Contact
                        </a>
                      <% } %>
                    </div>
                    
                    <div class="host-stats mt-3 d-flex gap-4">
                      <div class="host-stat">
                        <div class="host-stat-num mb-0 fw-bold fs-5"><%= listing.reviews.length %></div>
                        <div class="host-stat-label text-muted" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em;">Reviews</div>
                      </div>
                      <div class="host-stat">
                        <div class="host-stat-num mb-0 fw-bold fs-5"><% if(avgRatingTop) { %><%= avgRatingTop %><% } else { %>—<% } %></div>
                        <div class="host-stat-label text-muted" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em;">Rating</div>
                      </div>
                      <div class="host-stat">
                        <div class="host-stat-num mb-0 fw-bold fs-5">2</div>
                        <div class="host-stat-label text-muted" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em;">Years</div>
                      </div>
                    </div>

                    <div class="mt-4 row g-2">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 text-dark fs-6 opacity-75">
                                <i class="fa-solid fa-award text-warning"></i>
                                <span class="small fw-semibold">Superhost status</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 text-dark fs-6 opacity-75">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                                <span class="small fw-semibold">98% response rate</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 text-dark fs-6 opacity-75">
                                <i class="fa-solid fa-language"></i>
                                <span class="small fw-semibold">Speaks English, Hindi</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 text-dark fs-6 opacity-75">
                                <i class="fa-solid fa-shield-halved text-success"></i>
                                <span class="small fw-semibold">Identity verified</span>
                            </div>
                        </div>
                    </div>
                  </div>
                </div>

                <div class="mb-5 listing-description-wrap">
                    <p class="lead" style="line-height: 1.8; color: #484848; font-size: 1.15rem;">
                        <%= listing.description %>
                    </p>
                </div>

                <!-- Owner Actions -->
                <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                    <div class="mb-5 p-4 bg-light rounded-4 border">
                        <h5 class="fw-bold mb-3">Host Controls</h5>
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark me-2 rounded-pill px-4">Edit
                            Listing</a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                            <button class="btn btn-outline-danger rounded-pill px-4">Delete Listing</button>
                        </form>
                    </div>
                    <% } %>

                        <hr class="my-5" />

                        <hr class="my-5" />

                        <!-- Reviews Section -->
                        <div class="mb-5">
                            <h3 class="fw-bold mb-4"><i class="fa-solid fa-star text-warning me-2"></i> Reviews</h3>

                            <!-- Rating Breakdown Section -->
                            <% if(listing.reviews && listing.reviews.length> 0) {
                                // Calculate ratings
                                let totalRatings = listing.reviews.length;
                                let sumRatings = listing.reviews.reduce((acc, curr) => acc + curr.rating, 0);
                                let avgRating = (sumRatings / totalRatings).toFixed(1);

                                let starCounts = {5:0, 4:0, 3:0, 2:0, 1:0};
                                listing.reviews.forEach(r => {
                                if(r.rating >= 1 && r.rating <= 5) { starCounts[r.rating]++; } }); %>
                                    <div class="rating-overview">
                                        <div class="rating-overview-header">
                                            <!-- Overall Score -->
                                            <div class="rating-score">
                                                <div class="rating-score-number">
                                                    <%= avgRating %>
                                                </div>
                                                <div class="rating-score-stars">
                                                    <% for(let i=1; i<=5; i++) { %>
                                                        <i
                                                            class="fa-solid fa-star <%= i <= Math.round(avgRating) ? '' : 'text-secondary opacity-25' %>"></i>
                                                        <% } %>
                                                </div>
                                                <div class="rating-score-label">
                                                    <%= totalRatings %> reviews
                                                </div>
                                            </div>

                                            <!-- Rating Bars -->
                                            <div class="rating-breakdown">
                                                <% for(let stars=5; stars>=1; stars--) {
                                                    let percent = (starCounts[stars] / totalRatings) * 100;
                                                    %>
                                                    <div class="rating-bar-row">
                                                        <div class="rating-bar-label">
                                                            <%= stars %> <i class="fa-solid fa-star"></i>
                                                        </div>
                                                        <div class="rating-bar-container">
                                                            <div class="rating-bar-fill animated"
                                                                style="--bar-width: <%= percent %>%; width: 0;"></div>
                                                        </div>
                                                        <div class="rating-bar-percentage">
                                                            <%= Math.round(percent) %>%
                                                        </div>
                                                    </div>
                                                    <% } %>
                                            </div>
                                        </div>

                                        <!-- Categories (Derived from overall rating for demo) -->
                                        <div class="rating-categories">
                                            <div class="rating-category">
                                                <div class="rating-category-name"><i
                                                        class="fa-solid fa-spray-can-sparkles"></i> Cleanliness</div>
                                                <div class="rating-category-score">
                                                    <%= avgRating %>
                                                </div>
                                            </div>
                                            <div class="rating-category">
                                                <div class="rating-category-name"><i
                                                        class="fa-regular fa-circle-check"></i> Accuracy</div>
                                                <div class="rating-category-score">
                                                    <%= avgRating %>
                                                </div>
                                            </div>
                                            <div class="rating-category">
                                                <div class="rating-category-name"><i class="fa-solid fa-key"></i>
                                                    Check-in</div>
                                                <div class="rating-category-score">5.0</div>
                                            </div>
                                            <div class="rating-category">
                                                <div class="rating-category-name"><i class="fa-regular fa-message"></i>
                                                    Communication</div>
                                                <div class="rating-category-score">
                                                    <%= avgRating %>
                                                </div>
                                            </div>
                                            <div class="rating-category">
                                                <div class="rating-category-name"><i
                                                        class="fa-solid fa-map-location-dot"></i> Location</div>
                                                <div class="rating-category-score">
                                                    <%= avgRating %>
                                                </div>
                                            </div>
                                            <div class="rating-category">
                                                <div class="rating-category-name"><i class="fa-solid fa-tag"></i> Value
                                                </div>
                                                <div class="rating-category-score">
                                                    <%= avgRating %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>

                                        <% if(currUser) { %>
                                            <div class="card bg-light border-0 rounded-4 p-4 mb-5">
                                                <h5 class="fw-bold mb-3">Leave a Review</h5>
                                                <form method="POST" action="/listings/<%= listing._id %>/reviews"
                                                    novalidate class="needs-validation">
                                                    <div class="mb-3">
                                                        <label
                                                            class="form-label small fw-bold text-uppercase text-muted">Rating</label>
                                                        <fieldset class="starability-slot">
                                                            <input type="radio" id="no-rate" class="input-no-rate"
                                                                name="review[rating]" value="1" checked
                                                                aria-label="No rating." />
                                                            <input type="radio" id="first-rate1" name="review[rating]"
                                                                value="1" />
                                                            <label for="first-rate1" title="Terrible">1 star</label>
                                                            <input type="radio" id="first-rate2" name="review[rating]"
                                                                value="2" />
                                                            <label for="first-rate2" title="Not good">2 stars</label>
                                                            <input type="radio" id="first-rate3" name="review[rating]"
                                                                value="3" />
                                                            <label for="first-rate3" title="Average">3 stars</label>
                                                            <input type="radio" id="first-rate4" name="review[rating]"
                                                                value="4" />
                                                            <label for="first-rate4" title="Very good">4 stars</label>
                                                            <input type="radio" id="first-rate5" name="review[rating]"
                                                                value="5" />
                                                            <label for="first-rate5" title="Amazing">5 stars</label>
                                                        </fieldset>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="comment"
                                                            class="form-label small fw-bold text-uppercase text-muted">Comments</label>
                                                        <textarea class="form-control rounded-4 p-3" id="comment"
                                                            name="review[comment]" rows="3" required
                                                            placeholder="Share your experience..."></textarea>
                                                        <div class="invalid-feedback">Please add some comments.</div>
                                                    </div>
                                                    <button class="btn btn-dark rounded-pill px-4 fw-bold">Submit
                                                        Review</button>
                                                </form>
                                            </div>
                                            <% } %>

                                                <% if(listing.reviews.length> 0) { %>
                                                    <div class="row">
                                                        <% for (review of listing.reviews) { %>
                                                            <div class="col-md-6 mb-4">
                                                                <div
                                                                    class="card h-100 p-4 border rounded-4 review-card shadow-sm">
                                                                    <div class="d-flex justify-content-between mb-2">
                                                                        <div class="d-flex align-items-center">
                                                                            <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center me-3"
                                                                                style="width: 40px; height: 40px;">
                                                                                <i
                                                                                    class="fa-solid fa-user text-muted"></i>
                                                                            </div>
                                                                            <div>
                                                                                <h6 class="fw-bold mb-0">@<%=
                                                                                        review.author ?
                                                                                        review.author.username
                                                                                        : "Anonymous" %>
                                                                                </h6>
                                                                                <small class="text-muted">Verified
                                                                                    User</small>
