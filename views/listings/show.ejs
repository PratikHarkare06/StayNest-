    <script>
        function shareListing() {
            if (navigator.share) {
                navigator.share({
                    title: '<%= listing.title %>',
                    text: 'Check out this amazing place on Wanderlust!',
                    url: window.location.href,
                })
                    .catch((error) => console.log('Error sharing', error));
            } else {
                navigator.clipboard.writeText(window.location.href);
                toastSuccess('Link Copied!', 'The listing link has been copied to your clipboard.');
            }
        }

        // ===== MOBILE STICKY BOOKING BAR LOGIC =====
        function scrollToBooking() {
            const bookingCard = document.querySelector('.card.shadow-lg');
            if (bookingCard) {
                bookingCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                // Add a subtle highlight effect
                bookingCard.style.transition = 'box-shadow 0.3s ease';
                bookingCard.style.boxShadow = '0 0 0 3px rgba(255, 56, 92, 0.3)';
                setTimeout(() => {
                    bookingCard.style.boxShadow = '';
                }, 2000);
            }
        }

        // Show/hide sticky bar based on scroll position
        document.addEventListener('DOMContentLoaded', function () {
            const mobileBar = document.getElementById('mobileBookingBar');
            const heroImage = document.querySelector('.position-relative.mb-5');
            let lastScrollTop = 0;
            let isBarVisible = false;

            if (!mobileBar || !heroImage) return;

            // Only run on mobile
            if (window.innerWidth > 768) return;

            window.addEventListener('scroll', function () {
                const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                const heroBottom = heroImage.offsetTop + heroImage.offsetHeight;

                // Show bar when scrolled past hero image
                if (scrollTop > heroBottom && !isBarVisible) {
                    mobileBar.classList.add('visible');
                    document.body.classList.add('has-mobile-booking');
                    isBarVisible = true;
                }
                // Hide bar when scrolled back to top
                else if (scrollTop <= heroBottom && isBarVisible) {
                    mobileBar.classList.remove('visible');
                    document.body.classList.remove('has-mobile-booking');
                    isBarVisible = false;
                }

                lastScrollTop = scrollTop;
            });
        });
    </script>