    <script>
        function shareListing() {
            if (navigator.share) {
                navigator.share({
                    title: '<%= listing.title %>',
                    text: 'Check out this amazing place on Wanderlust!',
                    url: window.location.href,
                })
                    .catch((error) => console.log('Error sharing', error));
            } else {
                navigator.clipboard.writeText(window.location.href);
                toastSuccess('Link Copied!', 'The listing link has been copied to your clipboard.');
            }
        }

        // ===== MOBILE STICKY BOOKING BAR LOGIC =====
        function scrollToBooking() {
            const bookingCard = document.querySelector('.card.shadow-lg');
            if (bookingCard) {
                bookingCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                // Add a subtle highlight effect
                bookingCard.style.transition = 'box-shadow 0.3s ease';
                bookingCard.style.boxShadow = '0 0 0 3px rgba(255, 56, 92, 0.3)';
                setTimeout(() => {
                    bookingCard.style.boxShadow = '';
                }, 2000);
            }
        }

        // Show/hide sticky bar based on scroll position
        document.addEventListener('DOMContentLoaded', function () {
            const mobileBar = document.getElementById('mobileBookingBar');
            const heroImage = document.querySelector('.position-relative.mb-5');
            let lastScrollTop = 0;
            let isBarVisible = false;

            if (!mobileBar || !heroImage) return;

            // Only run on mobile
            if (window.innerWidth > 768) return;

            window.addEventListener('scroll', function () {
                const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                
                // Show bar after 200px scroll for better native feel
                if (scrollTop > 200 && !isBarVisible) {
                    mobileBar.classList.add('visible');
                    document.body.classList.add('has-mobile-booking');
                    isBarVisible = true;
                }
                // Hide bar when scrolled back to top area
                else if (scrollTop <= 150 && isBarVisible) {
                    mobileBar.classList.remove('visible');
                    document.body.classList.remove('has-mobile-booking');
                    isBarVisible = false;
                }

                lastScrollTop = scrollTop;
            });
        });
    </script>

    <!-- ── Lightbox + Viewer Counter JS ─────────────────────────────── -->
    <script>
    // ── Gallery URLs (mirrors EJS array) ─────────────────────────────────────
    const _imgUrl = "<%= listing.image.url %>";
    const _isCloudinary = _imgUrl.includes('cloudinary');
    const galleryUrls = [
      _imgUrl,
      _isCloudinary ? _imgUrl.replace('/upload/', '/upload/w_1200,h_800,c_fill,g_auto/') : _imgUrl,
      _isCloudinary ? _imgUrl.replace('/upload/', '/upload/w_1200,h_800,c_fill,g_south/') : _imgUrl,
      _isCloudinary ? _imgUrl.replace('/upload/', '/upload/w_1200,h_800,c_fill,g_north/') : _imgUrl,
      _isCloudinary ? _imgUrl.replace('/upload/', '/upload/w_1200,h_800,c_fill,g_east/') : _imgUrl,
    ];

    let currentIdx = 0;

    // ── Build thumbnails ──────────────────────────────────────────────────────
    function buildThumbs() {
      const wrap = document.getElementById('lightbox-thumbs');
      if (!wrap) return;
      wrap.innerHTML = galleryUrls.map((url, i) =>
        `<img src="${url}" class="lightbox-thumb ${i === 0 ? 'active' : ''}" onclick="goToPhoto(${i})" alt="photo ${i+1}">`
      ).join('');
    }

    function goToPhoto(idx) {
      currentIdx = (idx + galleryUrls.length) % galleryUrls.length;
      const img = document.getElementById('lightbox-img');
      img.style.opacity = '0';
      setTimeout(() => {
        img.src = galleryUrls[currentIdx];
        img.style.opacity = '1';
      }, 120);
      document.getElementById('lightbox-counter').textContent = `${currentIdx + 1} / ${galleryUrls.length}`;
      document.querySelectorAll('.lightbox-thumb').forEach((t, i) => {
        t.classList.toggle('active', i === currentIdx);
      });
    }

    function openLightbox(idx) {
      buildThumbs();
      document.getElementById('lightbox').classList.add('active');
      document.body.style.overflow = 'hidden';
      goToPhoto(idx);
    }

    function closeLightbox() {
      document.getElementById('lightbox').classList.remove('active');
      document.body.style.overflow = '';
    }

    function lightboxNav(dir) { goToPhoto(currentIdx + dir); }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      const lb = document.getElementById('lightbox');
      if (!lb.classList.contains('active')) return;
      if (e.key === 'ArrowRight') lightboxNav(1);
      if (e.key === 'ArrowLeft')  lightboxNav(-1);
      if (e.key === 'Escape')     closeLightbox();
    });

    // Touch swipe support
    let _touchX = null;
    document.getElementById('lightbox').addEventListener('touchstart', (e) => { _touchX = e.changedTouches[0].clientX; });
    document.getElementById('lightbox').addEventListener('touchend', (e) => {
      if (_touchX === null) return;
      const dx = e.changedTouches[0].clientX - _touchX;
      if (Math.abs(dx) > 50) lightboxNav(dx < 0 ? 1 : -1);
      _touchX = null;
    });

    // ── Live Viewers Counter ──────────────────────────────────────────────────
    (function() {
      const listingId = "<%= listing._id %>";
      let viewerCount = 0;

      function updateViewerBadge(n) {
        viewerCount = n;
        const badge = document.getElementById('viewers-badge');
        const countEl = document.getElementById('viewers-count');
        if (!badge || !countEl) return;
        countEl.textContent = n;
        badge.style.display = n > 1 ? 'inline-flex' : 'none';
      }

      // Use the global socket if available (user logged in)
      // Or create an anonymous connection just for viewer tracking
      const _sock = window._globalSocket || io();

      _sock.emit('join_listing', listingId);

      // Track viewers via presence
      let viewers = new Set();
      viewers.add('self');

      _sock.on('viewer_joined', ({ listingId: lid }) => {
        if (lid === listingId) {
          viewers.add(lid + Date.now());
          updateViewerBadge(viewers.size);
        }
      });

      _sock.on('viewer_left', ({ listingId: lid }) => {
        if (viewers.size > 1) viewers.delete([...viewers][viewers.size - 1]);
        updateViewerBadge(Math.max(1, viewers.size));
      });

      // Simulate realistic viewer count for demo (1-8 people)
      setTimeout(() => {
        const simCount = Math.floor(Math.random() * 6) + 2;
        updateViewerBadge(simCount);
      }, 2500);
    })();
    </script>