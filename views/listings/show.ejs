    <!-- Flatpickr -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        // Booking Guest Counter Logic
        const bookingGuests = { adults: 1, children: 0, infants: 0, pets: 0 };

        function toggleBookingGuestPopup() {
            const popup = document.querySelector('.booking-guest-popup');
            popup.classList.toggle('d-none');
        }

        function updateBookingGuest(type, change) {
            // Prevent adults from going below 1
            if (type === 'adults' && bookingGuests[type] + change < 1) return;
            // Prevent other counts from going below 0
            if (bookingGuests[type] + change < 0) return;

            bookingGuests[type] += change;
            document.getElementById(`booking-count-${type}`).innerText = bookingGuests[type];

            // Update Hidden Input
            const hiddenInput = document.getElementById(`booking-input-${type}`);
            if (hiddenInput) hiddenInput.value = bookingGuests[type];

            updateBookingGuestDisplay();
        }

        function updateBookingGuestDisplay() {
            const totalGuests = bookingGuests.adults + bookingGuests.children;
            const totalInfants = bookingGuests.infants;
            const totalPets = bookingGuests.pets;

            let arr = [];
            if (totalGuests > 0) arr.push(`${totalGuests} guest${totalGuests !== 1 ? 's' : ''}`);
            if (totalInfants > 0) arr.push(`${totalInfants} infant${totalInfants !== 1 ? 's' : ''}`);
            if (totalPets > 0) arr.push(`${totalPets} pet${totalPets !== 1 ? 's' : ''}`);

            const display = document.getElementById('bookingGuestDisplay');
            if (display) {
                display.innerText = arr.length > 0 ? arr.join(', ') : '1 guest';
            }
        }

        // Close popup when clicking outside
        document.addEventListener('click', function (e) {
            const guestSection = document.getElementById('bookingGuestSection');
            const popup = document.querySelector('.booking-guest-popup');

            if (popup && !popup.classList.contains('d-none')) {
                if (!guestSection.contains(e.target) && !popup.contains(e.target)) {
                    popup.classList.add('d-none');
                }
            }
        });
    </script>

    <!-- Store listing data in JSON script tag (safer than inline) -->
    <script id="listing-data" type="application/json">
        <%- JSON.stringify(listing) %>
    </script>

    <script id="bookings-data" type="application/json">
        <%- JSON.stringify(bookings || []) %>
    </script>

    <script>
        // Parse listing data from JSON script tag
        const listingDataElement = document.getElementById('listing-data');
        const listing = listingDataElement ? JSON.parse(listingDataElement.textContent) : null;

        const bookingsDataElement = document.getElementById('bookings-data');
        const bookings = bookingsDataElement ? JSON.parse(bookingsDataElement.textContent) : [];

        const mapToken = "<%- mapToken %>";

        console.log("Listing data loaded:", listing);
        console.log("Bookings data loaded:", bookings);

        // Convert bookings to disable format for Flatpickr
        const blockedDates = bookings.map(booking => {
            return {
                from: new Date(booking.checkIn),
                to: new Date(booking.checkOut)
            };
        });

        // Initialize Flatpickr
        const checkInPicker = flatpickr("#checkIn", {
            minDate: "today",
            disable: blockedDates,
            dateFormat: "Y-m-d",
            onChange: function (selectedDates, dateStr, instance) {
                if (selectedDates.length > 0) {
                    // Set checkout min date to checkin date + 1
                    const minOutDate = new Date(selectedDates[0]);
                    minOutDate.setDate(minOutDate.getDate() + 1);
                    checkOutPicker.set('minDate', minOutDate);
                    checkOutPicker.open(); // Auto open checkout
                }
            }
        });

        const checkOutPicker = flatpickr("#checkOut", {
            minDate: "today", // Will be updated
            disable: blockedDates,
            dateFormat: "Y-m-d"
        });
    </script>

