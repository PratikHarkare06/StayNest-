<% layout("/layouts/boilerplate") %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-9 col-lg-7">
        <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5">
          <h3 class="mb-4 text-center fw-bold">Edit Your Listing</h3>

          <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data"
            class="needs-validation" novalidate>
            <!-- Title -->
            <div class="mb-4">
              <label for="title" class="form-label fw-bold small text-muted text-uppercase">Title</label>
              <input id="title" name="listing[title]" value="<%= listing.title %>" type="text"
                class="form-control rounded-4 p-3 fw-bold" required />
            </div>

            <!-- Description -->
            <div class="mb-4">
              <label for="description" class="form-label fw-bold small text-muted text-uppercase">Description</label>
              <textarea id="description" name="listing[description]" class="form-control rounded-4 p-3" rows="4"
                required><%= listing.description %></textarea>
            </div>

            <!-- Image -->
            <div class="mb-4">
              <label class="form-label fw-bold small text-muted text-uppercase">Current Image</label> <br>
              <img src="<%= originalImageUrl %>" class="rounded-4 mb-3"
                style="height: 200px; object-fit: cover; width: 100%; max-width: 300px;" />

              <label for="image" class="form-label fw-bold small text-muted text-uppercase d-block mt-2">Upload New
                Image</label>
              <input id="image" name="listing[image]" type="file" class="form-control rounded-4 p-3" />
            </div>

            <!-- Price + Country -->
            <div class="row">
              <div class="mb-4 col-md-4">
                <label for="price" class="form-label fw-bold small text-muted text-uppercase">Price</label>
                <div class="input-group">
                  <span class="input-group-text rounded-start-4 bg-light border-end-0 fw-bold">₹</span>
                  <input id="price" name="listing[price]" value="<%= listing.price %>" type="number"
                    class="form-control rounded-end-4 p-3 border-start-0" required />
                </div>
              </div>

              <div class="mb-4 col-md-8">
                <label for="country" class="form-label fw-bold small text-muted text-uppercase">Country</label>
                <input id="country" name="listing[country]" value="<%= listing.country %>" type="text"
                  class="form-control rounded-4 p-3" required />
              </div>
            </div>

            <!-- Location -->
            <div class="mb-4">
              <label for="location" class="form-label fw-bold small text-muted text-uppercase">Location</label>
              <input id="location" name="listing[location]" value="<%= listing.location %>" type="text"
                class="form-control rounded-4 p-3" required />
            </div>

            <!-- Category -->
            <div class="mb-5">
              <label for="category" class="form-label fw-bold small text-muted text-uppercase">Category</label>
              <select id="category" name="listing[category]" class="form-select rounded-4 p-3" style="cursor: pointer;">
                <option value="">Select a category</option>
                <option value="Trending" <%=listing.category==='Trending' ? 'selected' : '' %>>Trending</option>
                <option value="Rooms" <%=listing.category==='Rooms' ? 'selected' : '' %>>Rooms</option>
                <option value="Iconic Cities" <%=listing.category==='Iconic Cities' ? 'selected' : '' %>>Iconic Cities
                </option>
                <option value="Mountains" <%=listing.category==='Mountains' ? 'selected' : '' %>>Mountains</option>
                <option value="Castles" <%=listing.category==='Castles' ? 'selected' : '' %>>Castles</option>
                <option value="Amazing Pools" <%=listing.category==='Amazing Pools' ? 'selected' : '' %>>Amazing Pools
                </option>
                <option value="Camping" <%=listing.category==='Camping' ? 'selected' : '' %>>Camping</option>
                <option value="Farms" <%=listing.category==='Farms' ? 'selected' : '' %>>Farms</option>
                <option value="Arctic" <%=listing.category==='Arctic' ? 'selected' : '' %>>Arctic</option>
                <option value="Domes" <%=listing.category==='Domes' ? 'selected' : '' %>>Domes</option>
                <option value="Boats" <%=listing.category==='Boats' ? 'selected' : '' %>>Boats</option>
              </select>
            </div>

            <!-- Submit Button -->
            <button class="btn btn-danger w-100 py-3 rounded-pill fw-bold fs-5 shadow-sm" type="submit"
              style="background-color: #FF385C; border: none;">Update Listing</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Geoapify Autocomplete Support -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/geoapify/address-autocomplete-field@0.1.0/dist/address-autocomplete-field.min.css">
  <script src="https://cdn.jsdelivr.net/gh/geoapify/address-autocomplete-field@0.1.0/dist/address-autocomplete-field.min.js"></script>

  <script>
    const mapToken = "<%= mapToken %>";
    const addressInput = document.getElementById("location");

    if (addressInput && mapToken) {
      // Initialize Geoapify Autocomplete
      addressInput.addEventListener("input", async (e) => {
        const value = e.target.value;
        if (value.length < 3) return;

        const url = `https://api.geoapify.com/v1/geocode/autocomplete?text=${encodeURIComponent(value)}&apiKey=${mapToken}&limit=5`;
        
        try {
            const response = await fetch(url);
            const data = await response.json();
            
            let dropdown = document.getElementById("autocomplete-results");
            if (!dropdown) {
                dropdown = document.createElement("div");
                dropdown.id = "autocomplete-results";
                dropdown.className = "list-group position-absolute w-100 shadow-lg z-3";
                addressInput.parentNode.style.position = "relative";
                addressInput.parentNode.appendChild(dropdown);
            }
            
            dropdown.innerHTML = "";
            data.features.forEach(feature => {
                const item = document.createElement("button");
                item.type = "button";
                item.className = "list-group-item list-group-item-action";
                item.innerText = feature.properties.formatted;
                item.onclick = () => {
                   addressInput.value = feature.properties.formatted;
                   if(feature.properties.country) {
                       document.getElementById("country").value = feature.properties.country;
                   }
                   dropdown.innerHTML = "";
                };
                dropdown.appendChild(item);
            });
        } catch(err) { console.error(err); }
      });

      document.addEventListener("click", (e) => {
          const dropdown = document.getElementById("autocomplete-results");
          if(dropdown && e.target !== addressInput) {
              dropdown.innerHTML = "";
          }
      });
    }
  </script>