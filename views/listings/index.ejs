<% layout("/layouts/boilerplate") %>

  <div id="filters-main-container" class="d-flex align-items-center sticky-top bg-white z-3 py-2">
    <!-- Scrollable Categories with Arrows -->
    <div class="d-flex align-items-center position-relative flex-grow-1 overflow-hidden">
      
      <div id="filters" class="d-flex align-items-center overflow-x-auto flex-grow-1 pe-3" style="scrollbar-width: none; scroll-behavior: smooth;">
        <% const categories = [
          { name: 'Trending', icon: 'fa-fire' },
          { name: 'Rooms', icon: 'fa-bed' },
          { name: 'Iconic Cities', icon: 'fa-mountain-city' },
          { name: 'Mountains', icon: 'fa-mountain' },
          { name: 'Castles', icon: 'fa-fort-awesome', brand: true },
          { name: 'Amazing Pools', icon: 'fa-person-swimming' },
          { name: 'Camping', icon: 'fa-campground' },
          { name: 'Farms', icon: 'fa-cow' },
          { name: 'Arctic', icon: 'fa-snowflake', regular: true },
          { name: 'Domes', icon: 'fa-igloo' },
          { name: 'Boats', icon: 'fa-ship' }
        ]; %>

        <% for(let cat of categories) { %>
          <a href="/listings?category=<%= cat.name %>" 
             class="filter <%= (typeof category !== 'undefined' && category === cat.name) ? 'active' : '' %>"
             data-category="<%= cat.name %>">
            <div><i class="<%= cat.brand ? 'fa-brands' : (cat.regular ? 'fa-regular' : 'fa-solid') %> <%= cat.icon %>"></i></div>
            <p><%= cat.name %></p>
          </a>
        <% } %>
      </div>

    </div>

    <!-- Fixed Action Buttons -->
    <div class="d-none d-md-flex align-items-center ms-auto gap-2">
      <div class="tax-toggle">
        <div class="form-check form-switch form-check-reverse p-0 m-0 d-flex align-items-center justify-content-between w-100">
          <label class="form-check-label fs-6 fw-semibold me-2 cursor-pointer" for="flexSwitchCheckDefault">Display total after taxes</label>
          <input class="form-check-input m-0 cursor-pointer" type="checkbox" role="switch" id="flexSwitchCheckDefault" style="height: 1.5rem; width: 2.5rem;">
        </div>
      </div>

      <div class="tax-toggle">
        <div class="form-check form-switch form-check-reverse p-0 m-0 d-flex align-items-center justify-content-between w-100">
          <label class="form-check-label fs-6 fw-semibold me-2 cursor-pointer" for="flexSwitchCheckDefaultMap">Map</label>
          <input class="form-check-input m-0 cursor-pointer" type="checkbox" role="switch" id="flexSwitchCheckDefaultMap" autocomplete="off" style="height: 1.5rem; width: 2.5rem;">
        </div>
      </div>
    </div>

    <button class="btn btn-outline-dark ms-2 d-md-none rounded-circle p-2" type="button" data-bs-toggle="modal" data-bs-target="#filtersModal" style="width: 40px; height: 40px;">
      <i class="fa-solid fa-sliders mx-auto"></i>
    </button>

    <button class="btn btn-outline-dark ms-2 d-none d-md-flex align-items-center rounded-pill py-2 px-3 fw-bold" type="button" data-bs-toggle="modal" data-bs-target="#filtersModal" style="border: 1px solid #ddd; font-size: 0.9rem;">
      <i class="fa-solid fa-sliders me-2"></i> Filters
    </button>
  </div>

  <div class="container-fluid px-md-4">
    <div id="main-content-row" class="row">
      <!-- Listings Grid (Full Width) -->
      <div id="listings-side" class="col-12">
        
        <!-- Skeleton Loader -->
        <div id="listings-skeleton" class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 mt-3 d-none">
          <% for(let i=0; i<8; i++) { %>
            <div class="col mb-4">
              <div class="skeleton-loader">
                <div class="skeleton-box skeleton-img"></div>
                <div class="skeleton-box" style="width: 70%; height: 1.2rem;"></div>
                <div class="skeleton-box" style="width: 40%; height: 1rem;"></div>
              </div>
            </div>
          <% } %>
        </div>

        <div id="listings-container" class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 mt-3">
    <% if(allListings && allListings.length > 0) { %>
      <% for (let listing of allListings) { %>
        <div class="col mb-4 listing-fade-in shadow-hover">
          <div class="card h-100 listing-card border-0 position-relative">
            
            <div class="position-relative overflow-hidden rounded-4">
              <img src="/images/placeholder.jpg"
                data-src="<%- listing.image && listing.image.url ? listing.image.url : '/images/placeholder.jpg' %>"
                class="card-img-top lazy-load" alt="<%= listing.title %>" style="height: 18rem; object-fit: cover" />
              
              <!-- Wishlist Heart -->
              <% if(currUser) { %>
                <form action="/users/wishlist/<%= listing._id %>" method="POST" class="position-absolute end-0 top-0 m-3 wishlist-form" style="z-index: 10;">
                  <button class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center border-0 shadow-sm bg-white bg-opacity-75" style="width: 32px; height: 32px; cursor: pointer;">
                    <i class="<%= currUser.wishlist.some(id => id.equals(listing._id)) ? 'fa-solid text-danger' : 'fa-regular text-dark' %> fa-heart"></i>
                  </button>
                </form>
              <% } %>
            </div>

            <div class="card-body px-1 pt-3">
              <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark stretched-link">
                <div class="d-flex justify-content-between align-items-start">
                  <h6 class="fw-bold mb-0 text-truncate" style="max-width: 80%;"><%= listing.title %></h6>
                  <div class="d-flex align-items-center gap-1">
                    <i class="fa-solid fa-star small"></i>
                    <span class="small fw-semibold">New</span>
                  </div>
                </div>
                <p class="text-muted small mb-1"><%= listing.location %>, <%= listing.country %></p>
                <p class="card-text mb-0">
                  <span class="fw-bold text-dark fs-6 listing-price" data-base-price="<%= listing.price %>">
                    &#8377; <%= listing.price.toLocaleString("en-IN") %>
                  </span>
                  <span class="text-muted fw-normal">night</span>
                  <i class="tax-info text-muted ms-1" style="display: none; font-size: 0.8em;">&nbsp;+18% GST</i>
                </p>
              </a>
            </div>
          </div>
        </div>
      <% } %>
    <% } else { %>
            <!-- EMPTY STATE UPGRADED -->
            <div class="col-12 text-center py-5 mt-5">
              <div class="mb-4">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px;">
                  <i class="fa-solid fa-magnifying-glass fa-2x text-muted opacity-50"></i>
                </div>
              </div>
              <h4 class="fw-bold text-dark">No matches found</h4>
              <p class="text-muted mx-auto" style="max-width: 400px;">Try adjusting your filters or search keywords to find what you're looking for.</p>
              <div class="d-flex gap-2 justify-content-center mt-3">
                <a href="/listings" class="btn btn-dark rounded-pill px-4 fw-bold">Clear all filters</a>
                <button class="btn btn-outline-dark rounded-pill px-4 fw-bold" onclick="openSearch('where')">Try new search</button>
              </div>
            </div>
    <% } %>
        </div>

        <!-- Full-width Map Section (At Bottom) -->
        <div class="col-12 mt-5 pt-5 border-top mb-5">
            <h4 class="fw-bold mb-4">Where you'll be</h4>
            <div id="cluster-map" class="rounded-4 overflow-hidden border shadow-sm" style="height: 500px; width: 100%;"></div>
        </div>

      </div>
    </div>
  </div>

  <!-- Filter Modal (Moved outside layout) -->
  <div class="modal fade" id="filtersModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 shadow">
        <div class="modal-header border-bottom-0 pb-0">
          <h1 class="modal-title fs-5 fw-bold">Filters</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <form action="/listings" method="GET">
            <% if(typeof category !=='undefined' && category) { %><input type="hidden" name="category" value="<%= category %>"> <% } %>
            <% if(typeof q !=='undefined' && q) { %><input type="hidden" name="q" value="<%= q %>"> <% } %>

            <!-- Price Range Filter -->
            <div class="mb-4">
              <h5 class="fw-bold mb-3">Price Range</h5>
              <div class="d-flex align-items-center gap-3">
                <div class="form-floating flex-grow-1">
                  <input type="number" class="form-control rounded-4" id="minPrice" name="minPrice" placeholder="Min" min="0" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>">
                  <label for="minPrice">Min price</label>
                </div>
                <div class="text-muted">-</div>
                <div class="form-floating flex-grow-1">
                  <input type="number" class="form-control rounded-4" id="maxPrice" name="maxPrice" placeholder="Max" min="0" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>">
                  <label for="maxPrice">Max price</label>
                </div>
              </div>
            </div>

            <h6 class="fw-bold mb-3">Sort By</h6>
            <div class="d-flex gap-2 mb-4">
              <input type="radio" class="btn-check" name="sort" id="sortNew" value="newest" checked>
              <label class="btn btn-outline-dark rounded-pill flex-grow-1" for="sortNew">Newest</label>

              <input type="radio" class="btn-check" name="sort" id="sortLow" value="price_low">
              <label class="btn btn-outline-dark rounded-pill flex-grow-1" for="sortLow">Price: Low</label>

              <input type="radio" class="btn-check" name="sort" id="sortHigh" value="price_high">
              <label class="btn btn-outline-dark rounded-pill flex-grow-1" for="sortHigh">Price: High</label>
            </div>

            <div class="d-grid pt-2 border-top">
              <button class="btn btn-dark rounded-pill py-3 fw-bold mt-3">Show results</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading Spinner -->
  <!-- Skeleton Loading (Hidden by default) -->
  <div id="loading-spinner" class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3 d-none">
    <% for(let i=0; i<6; i++) { %>
      <div class="col mb-4">
        <div class="skeleton-card">
          <div class="skeleton skeleton-img"></div>
          <div class="skeleton skeleton-text"></div>
          <div class="skeleton skeleton-text short"></div>
          <div class="skeleton skeleton-text" style="width: 40%;"></div>
        </div>
      </div>
      <% } %>
  </div>

  <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
    <nav aria-label="Page navigation" class="mt-4 mb-5 d-none d-md-block">
      <!-- Hidden on mobile, or just hide entirely if scroll is preferred -->
      <ul class="pagination justify-content-center">

        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
          <a class="page-link" href="/listings<%= queryString %>&page=<%= currentPage - 1 %>" aria-label="Previous">
            <span aria-hidden="true">&laquo;</span>
          </a>
        </li>

        <% let startPage=Math.max(1, currentPage - 2); let endPage=Math.min(totalPages, currentPage + 2); if (startPage>
          1) { %>
          <li class="page-item"><a class="page-link" href="/listings<%= queryString %>&page=1">1</a></li>
          <% if (startPage> 2) { %> <li class="page-item disabled"><span class="page-link">...</span></li>
            <% } %>
              <% } for(let i=startPage; i <=endPage; i++) { %>
                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                  <a class="page-link" href="/listings<%= queryString %>&page=<%= i %>">
                    <%= i %>
                  </a>
                </li>
                <% } if (endPage < totalPages) { %>
                  <% if (endPage < totalPages - 1) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                    <% } %>
                      <li class="page-item"><a class="page-link"
                          href="/listings<%= queryString %>&page=<%= totalPages %>">
                          <%= totalPages %>
                        </a></li>
                      <% } %>

                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                          <a class="page-link" href="/listings<%= queryString %>&page=<%= currentPage + 1 %>"
                            aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                          </a>
                        </li>
      </ul>
    </nav>
    <% } %>

      <!-- Mobile Floating Map Button -->
      <button id="floatingMapBtn" class="floating-map-btn" onclick="toggleMap()">
        <i class="fa-solid fa-map"></i>&nbsp;Map
      </button>

      <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
        <!-- Pagination ... (Keep existing pagination if possible or just include it if I'm replacing the whole block) -->
        <!-- ... skipped for brevity in replace content, I should be careful not to delete pagination -->
        <!-- Wait, I am replacing from line 223 which is AFTER pagination. -->

        <!-- Actually, line 223 is inside the 'if totalPages > 1' block? No, line 221 is closing brace. -->
        <!-- Line 223 is <script> const mapToken ... -->
        <!-- So I will replace the Scripts area only. -->
        <% } %>

          <script id="discoveryServerData" type="application/json">
            {
              "totalPages": <%- typeof totalPages !== 'undefined' ? totalPages : 0 %>,
              "currentUser": "<%= currUser ? currUser._id : '' %>",
              "mapToken": "<%= mapToken %>"
            }
          </script>

          <script>
            /* Discovery & Performance JS */
            document.addEventListener('DOMContentLoaded', function() {
              // 1. Clear Skeleton after load or simulate it
              const skeleton = document.getElementById('listings-skeleton');
              const container = document.getElementById('listings-container');
              
              // If listings are already there, hide skeleton in 300ms for that "app load" feel
              if (container && container.children.length > 0) {
                 setTimeout(() => {
                   if(skeleton) skeleton.classList.add('d-none');
                   container.classList.remove('d-none');
                 }, 400);
              }

              // 2. Category Active State Sync (from Query)
              const urlParams = new URLSearchParams(window.location.search);
              const currentCat = urlParams.get('category');
              if (currentCat) {
                document.querySelectorAll('.filter').forEach(f => {
                  if (f.dataset.category === currentCat) f.classList.add('active');
                  else f.classList.remove('active');
                });
              }

              // 3. Category Bar Scroll Arrows Appearance (Optional logic for future)
            });

            /* Infinite Scroll & Map Config */
            const serverDataEl = document.getElementById('discoveryServerData');
            const discoveryData = serverDataEl ? JSON.parse(serverDataEl.textContent) : {};
            
            const mapToken = discoveryData.mapToken;
            const allListingsMapElement = document.getElementById('allListingsMapData');
            const allListingsMap = allListingsMapElement ? JSON.parse(allListingsMapElement.textContent) : [];
            const totalPagesServer = discoveryData.totalPages;
          </script>
          <script src="/static_js/infiniteScroll.js"></script>
          <script src="/static_js/clusterMap.js"></script>
          <script>
            let taxSwitch = document.getElementById("flexSwitchCheckDefault");
            if (taxSwitch) {
              taxSwitch.addEventListener("click", () => {
                let taxInfo = document.getElementsByClassName("tax-info");
                let priceElements = document.getElementsByClassName("listing-price");

                for (let i = 0; i < priceElements.length; i++) {
                  let basePrice = parseFloat(priceElements[i].getAttribute("data-base-price"));

                  if (taxSwitch.checked) {
                    // Show total price
                    let totalPrice = basePrice * 1.18;
                    priceElements[i].innerHTML = "&#8377; " + totalPrice.toLocaleString("en-IN", { maximumFractionDigits: 0 });
                    taxInfo[i].style.display = "inline";
                    taxInfo[i].innerText = " incl. taxes";
                  } else {
                    // Show base price
                    priceElements[i].innerHTML = "&#8377; " + basePrice.toLocaleString("en-IN");
                    taxInfo[i].style.display = "none";
                  }
                }
              });
            }

            // ===== SKELETON LOADING LOGIC =====
            document.addEventListener('DOMContentLoaded', function () {
              const loadingSkeletons = document.getElementById('loading-spinner');
              if (loadingSkeletons) loadingSkeletons.classList.add('d-none');
            });
          </script>