<% layout("/layouts/boilerplate") %>

    <div class="container-fluid dashboard-container">
        <div class="row">
            <!-- Sidebar / Profile Section -->
            <div class="col-lg-3 col-md-4 mb-4">
                <div class="card border-0 shadow-sm profile-card sticky-top"
                    style="top: 100px; border-radius: 20px; overflow: hidden;">
                    <div class="card-header bg-transparent border-0 text-center pt-5 pb-4"
                        style="background: linear-gradient(135deg, #FF385C 0%, #E61E4D 100%);">
                        <div class="profile-img-wrapper mb-3 mx-auto">
                            <img src="<%= user.image && user.image.url ? user.image.url : 'https://images.unsplash.com/photo-1511367461989-f85a21fda167?q=80&w=2831&auto=format&fit=crop' %>"
                                alt="profile-image" class="rounded-circle profile-img border border-4 border-white">
                        </div>
                        <h4 class="text-white fw-bold mb-1">@<%= user.username %>
                        </h4>
                        <p class="text-white-50 small mb-0">
                            <%= user.email %>
                        </p>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-around text-center mb-4">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">
                                    <%= myBookings.length %>
                                </h5>
                                <small class="text-muted">Trips</small>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">
                                    <%= myListings.length %>
                                </h5>
                                <small class="text-muted">Listings</small>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">
                                    <%= user.wishlist.length %>
                                </h5>
                                <small class="text-muted">Wishlist</small>
                            </div>
                        </div>
                        <hr class="text-muted opacity-25">
                        <p class="text-muted small mb-4">
                            <i class="fa-solid fa-quote-left text-danger me-2"></i>
                            <%= user.bio || "No bio added yet. Tell the world a bit about yourself!" %>
                        </p>
                        <button class="btn btn-outline-dark rounded-pill w-100 btn-sm" data-bs-toggle="modal"
                            data-bs-target="#editProfileModal">Edit Profile</button>
                        <p class="text-center mt-3 text-muted" style="font-size: 0.8rem;">Member since <%= new
                                Date().getFullYear() %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Main Content Section -->
            <div class="col-lg-9 col-md-8">
                <!-- Tabs Navigation -->
                <ul class="nav nav-pills mb-4 nav-justified bg-white p-2 rounded-pill shadow-sm" id="dashboardTabs"
                    role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill fw-bold" id="bookings-tab" data-bs-toggle="pill"
                            data-bs-target="#bookings" type="button" role="tab" aria-selected="true">
                            <i class="fa-solid fa-suitcase-rolling me-2"></i>My Trips
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-bold" id="listings-tab" data-bs-toggle="pill"
                            data-bs-target="#listings" type="button" role="tab" aria-selected="false">
                            <i class="fa-solid fa-house-user me-2"></i>My Properties
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-bold" id="wishlist-tab" data-bs-toggle="pill"
                            data-bs-target="#wishlist" type="button" role="tab" aria-selected="false">
                            <i class="fa-solid fa-heart me-2"></i>Wishlist
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-bold" id="analytics-tab" data-bs-toggle="pill"
                            data-bs-target="#analytics" type="button" role="tab" aria-selected="false">
                            <i class="fa-solid fa-chart-line me-2"></i>Analytics
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="dashboardTabsContent">

                    <!-- My Bookings Tab -->
                    <div class="tab-pane fade show active" id="bookings" role="tabpanel">
                        <% if(myBookings && myBookings.length> 0) { %>
                            <div class="row">
                                <% for(let booking of myBookings) { %>
                                    <div class="col-xl-6 mb-4">
                                        <div class="card h-100 border-0 shadow-sm booking-card position-relative">
                                            <div class="row g-0 h-100">
                                                <div class="col-4">
                                                    <img src="/images/placeholder.jpg"
                                                        data-src="<%= booking.listing.image.url %>"
                                                        class="img-fluid rounded-start h-100 object-fit-cover lazy-load"
                                                        alt="listing" style="min-height: 150px;">
                                                </div>
                                                <div class="col-8">
                                                    <div
                                                        class="card-body py-3 pe-3 ps-2 d-flex flex-column h-100 justify-content-between">
                                                        <!-- Whole card link -->
                                                        <a href="/listings/<%= booking.listing._id %>"
                                                            class="stretched-link"></a>

                                                        <div>
                                                            <h6 class="card-title fw-bold text-truncate mb-1">
                                                                <%= booking.listing.title %>
                                                            </h6>
                                                            <p class="text-muted small mb-2"><i
                                                                    class="fa-solid fa-location-dot me-1"></i>
                                                                <%= booking.listing.location %>
                                                            </p>

                                                            <div class="d-flex align-items-center mb-2">
                                                                <div class="badge bg-light text-dark border me-2">
                                                                    <i class="fa-regular fa-calendar me-1"></i>
                                                                    <%= new
                                                                        Date(booking.checkIn).toLocaleDateString('en-GB')
                                                                        %> - <%= new
                                                                            Date(booking.checkOut).toLocaleDateString('en-GB')
                                                                            %>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-end">
                                                            <div>
                                                                <span
                                                                    class="badge <%= booking.status === 'Confirmed' ? 'bg-success' : 'bg-warning' %> bg-opacity-10 text-<%= booking.status === 'Confirmed' ? 'success' : 'warning' %> px-2 py-1">
                                                                    <%= booking.status %>
                                                                </span>
                                                            </div>
                                                            <div class="text-end">
                                                                <small class="text-muted d-block">Total Price</small>
                                                                <span class="fw-bold text-dark">&#8377; <%=
                                                                        booking.totalPrice.toLocaleString("en-IN") %>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                            <% } else { %>
                                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                                    <i class="fa-solid fa-suitcase-rolling fa-3x text-muted mb-3 opacity-50"></i>
                                    <h5 class="fw-bold text-muted">No trips booked... yet!</h5>
                                    <p class="text-muted mb-4">Time to dust off your bags and start planning your next
                                        adventure.</p>
                                    <a href="/listings" class="btn btn-outline-danger rounded-pill px-4">Detailed
                                        Search</a>
                                </div>
                                <% } %>
                    </div>

                    <!-- My Listings Tab -->
                    <div class="tab-pane fade" id="listings" role="tabpanel">
                        <% if(myListings && myListings.length> 0) { %>
                            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                                <% for(let listing of myListings) { %>
                                    <div class="col">
                                        <div
                                            class="card h-100 border-0 shadow-sm listing-card-dashboard position-relative">
                                            <div class="position-relative">
                                                <img src="/images/placeholder.jpg" data-src="<%= listing.image.url %>"
                                                    class="card-img-top rounded-top lazy-load" alt="listing_image"
                                                    style="height: 200px; object-fit: cover;">
                                                <div class="card-img-overlay p-2 text-end">
                                                    <span class="badge bg-dark bg-opacity-75">Owned</span>
                                                </div>
                                            </div>
                                            <div class="card-body p-3 d-flex flex-column">
                                                <h6 class="card-title fw-bold text-truncate">
                                                    <%= listing.title %>
                                                </h6>
                                                <p class="card-text text-muted small mb-2">
                                                    <%= listing.location %>
                                                </p>
                                                <!-- Whole card link -->
                                                <a href="/listings/<%= listing._id %>" class="stretched-link"></a>

                                                <div class="mt-auto d-flex justify-content-end align-items-center pt-2">
                                                    <!-- Dropdown must be above the stretched link -->
                                                    <div class="dropdown" style="position: relative; z-index: 2;">
                                                        <button class="btn btn-sm btn-light rounded-circle border"
                                                            type="button" data-bs-toggle="dropdown">
                                                            <i class="fa-solid fa-ellipsis-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                                                            <li><a class="dropdown-item"
                                                                    href="/listings/<%= listing._id %>/edit"><i
                                                                        class="fa-solid fa-pen me-2 small"></i>Edit</a>
                                                            </li>
                                                            <li>
                                                                <form method="POST"
                                                                    action="/listings/<%= listing._id %>?_method=DELETE"
                                                                    class="d-inline p-0">
                                                                    <button class="dropdown-item text-danger"><i
                                                                            class="fa-solid fa-trash me-2 small"></i>Delete</button>
                                                                </form>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                                        <!-- Add New Listing Card -->
                                        <div class="col">
                                            <a href="/listings/new" class="text-decoration-none">
                                                <div class="card h-100 border-2 border-dashed border-secondary bg-transparent d-flex align-items-center justify-content-center text-center p-4"
                                                    style="min-height: 300px; opacity: 0.6; transition: all 0.3s;">
                                                    <div>
                                                        <div class="mb-3">
                                                            <i class="fa-solid fa-plus fa-3x text-secondary"></i>
                                                        </div>
                                                        <h6 class="fw-bold text-secondary">List a New Property</h6>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                            </div>
                            <% } else { %>
                                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                                    <i class="fa-solid fa-house-chimney-crack fa-3x text-muted mb-3 opacity-50"></i>
                                    <h5 class="fw-bold text-muted">No properties listed</h5>
                                    <p class="text-muted mb-4">Earn extra income by hosting your home using our
                                        platform.</p>
                                    <a href="/listings/new" class="btn btn-primary rounded-pill px-4 shadow-sm">Airbnb
                                        your home</a>
                                </div>
                                <% } %>
                    </div>

                    <!-- Wishlist Tab -->
                    <div class="tab-pane fade" id="wishlist" role="tabpanel">
                        <% if(user.wishlist && user.wishlist.length> 0) { %>
                            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                                <% for(let listing of user.wishlist) { %>
                                    <div class="col">
                                        <div class="card h-100 border-0 shadow-sm listing-card-dashboard">
                                            <div class="position-relative">
                                                <img src="/images/placeholder.jpg" data-src="<%= listing.image.url %>"
                                                    class="card-img-top rounded-top lazy-load" alt="listing_image"
                                                    style="height: 200px; object-fit: cover;">
                                                <form action="/users/wishlist/<%= listing._id %>" method="POST"
                                                    class="position-absolute top-0 end-0 p-2 wishlist-form">
                                                    <button
                                                        class="btn btn-light btn-sm rounded-circle shadow-sm text-danger border-0">
                                                        <i class="fa-solid fa-heart"></i>
                                                    </button>
                                                </form>
                                            </div>
                                            <div class="card-body p-3">
                                                <h6 class="card-title fw-bold text-truncate">
                                                    <%= listing.title %>
                                                </h6>
                                                <p class="card-text text-muted small mb-0">
                                                    <%= listing.location %>
                                                </p>
                                                <div class="mt-2">
                                                    <span class="fw-bold">&#8377; <%=
                                                            listing.price.toLocaleString("en-IN") %></span>
                                                    <small>night</small>
                                                </div>
                                                <a href="/listings/<%= listing._id %>" class="stretched-link"></a>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                            <% } else { %>
                                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                                    <i class="fa-regular fa-heart fa-3x text-muted mb-3 opacity-50"></i>
                                    <h5 class="fw-bold text-muted">Your wishlist is empty</h5>
                                    <p class="text-muted mb-4">Save properties you love to find them easily later.</p>
                                    <a href="/listings" class="btn btn-outline-primary rounded-pill px-4">Explore
                                        listings</a>
                                </div>
                                <% } %>
                    </div>

                    <!-- Analytics Tab -->
                    <div class="tab-pane fade" id="analytics" role="tabpanel">
                        <% if(typeof hostStats !=='undefined' ) { %>
                            <div class="row g-4 mb-4">
                                <div class="col-md-4">
                                    <a href="#earnings-chart" class="text-decoration-none">
                                        <div class="card border-0 shadow-sm rounded-4 text-white card-hover"
                                            style="background: linear-gradient(135deg, #008489 0%, #2ec4b6 100%);">
                                            <div class="card-body p-4">
                                                <div class="d-flex align-items-center mb-2">
                                                    <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">
                                                        <i class="fa-solid fa-indian-rupee-sign fa-lg"></i>
                                                    </div>
                                                    <h6 class="mb-0 opacity-75">Total Earnings</h6>
                                                </div>
                                                <h3 class="fw-bold mb-0">&#8377; <%=
                                                        hostStats.totalEarnings.toLocaleString("en-IN") %>
                                                </h3>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-4">
                                    <a href="#client-bookings" class="text-decoration-none">
                                        <div class="card border-0 shadow-sm rounded-4 bg-white card-hover">
                                            <div class="card-body p-4">
                                                <div class="d-flex align-items-center mb-2">
                                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                                        <i class="fa-solid fa-calendar-check text-primary fa-lg"></i>
                                                    </div>
                                                    <h6 class="mb-0 text-muted">Total Bookings</h6>
                                                </div>
                                                <h3 class="fw-bold mb-0 text-dark">
                                                    <%= hostStats.totalBookings %>
                                                </h3>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-4">
                                    <a href="#host-reviews" class="text-decoration-none">
                                        <div class="card border-0 shadow-sm rounded-4 bg-white card-hover">
                                            <div class="card-body p-4">
                                                <div class="d-flex align-items-center mb-2">
                                                    <div class="bg-warning bg-opacity-10 rounded-circle p-2 me-3">
                                                        <i class="fa-solid fa-star text-warning fa-lg"></i>
                                                    </div>
                                                    <h6 class="mb-0 text-muted">Avg. Rating</h6>
                                                </div>
                                                <h3 class="fw-bold mb-0 text-dark">
                                                    <%= hostStats.avgRating %>
                                                </h3>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </div>

                            <div id="analytics-wrapper" class="card border-0 shadow-sm p-4 mb-4 rounded-4 scroll-mt">
                                <h5 class="fw-bold mb-4">Analytics Overview (<%= new Date().getFullYear() %>)</h5>
                                <div style="position: relative; height: 350px; width: 100%;">
                                    <canvas id="analyticsGraph"
                                        data-earnings='<%- JSON.stringify(hostStats.earningsByMonth) %>'
                                        data-bookings='<%- JSON.stringify(hostStats.bookingsByMonth) %>'></canvas>
                                </div>
                            </div>

                            <!-- Reservations Table -->
                            <div id="client-bookings" class="card border-0 shadow-sm rounded-4 mb-4 scroll-mt">
                                <div class="card-header bg-white border-0 pt-4 px-4">
                                    <h5 class="fw-bold mb-0">Reservations (Received)</h5>
                                </div>
                                <div class="card-body px-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th class="ps-4">Guest</th>
                                                    <th>Property</th>
                                                    <th>Check-In</th>
                                                    <th>Check-Out</th>
                                                    <th>Status</th>
                                                    <th class="text-end pe-4">Payout</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if(hostBookings && hostBookings.length> 0) { %>
                                                    <% for(let activeBooking of hostBookings.reverse()) { %>
                                                        <tr>
                                                            <td class="ps-4">
                                                                <div class="d-flex align-items-center">
                                                                    <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2"
                                                                        style="width:35px;height:35px;font-weight:bold;color:#777;">
                                                                        <%= activeBooking.user ?
                                                                            activeBooking.user.username[0].toUpperCase()
                                                                            : '?' %>
                                                                    </div>
                                                                    <span>
                                                                        <%= activeBooking.user ?
                                                                            activeBooking.user.username : 'Unknown' %>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <% const bListing=myListings.find(l=>
                                                                    l._id.equals(activeBooking.listing)); %>
                                                                    <span class="text-truncate d-inline-block"
                                                                        style="max-width: 150px;">
                                                                        <%= bListing ? bListing.title
                                                                            : 'Deleted Listing' %>
                                                                    </span>
                                                            </td>
                                                            <td>
                                                                <%= new Date(activeBooking.checkIn).toLocaleDateString()
                                                                    %>
                                                            </td>
                                                            <td>
                                                                <%= new
                                                                    Date(activeBooking.checkOut).toLocaleDateString() %>
                                                            </td>
                                                            <td><span
                                                                    class="badge bg-success bg-opacity-10 text-success">
                                                                    <%= activeBooking.status %>
                                                                </span></td>
                                                            <td class="text-end pe-4 fw-bold">&#8377;<%=
                                                                    activeBooking.totalPrice.toLocaleString("en-IN") %>
                                                            </td>
                                                        </tr>
                                                        <% } %>
                                                            <% } else { %>
                                                                <tr>
                                                                    <td colspan="6" class="text-center py-4 text-muted">
                                                                        No reservations received yet.</td>
                                                                </tr>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Reviews Section -->
                            <div id="host-reviews" class="card border-0 shadow-sm rounded-4 mb-4 scroll-mt">
                                <div class="card-header bg-white border-0 pt-4 px-4">
                                    <h5 class="fw-bold mb-0">Recent Reviews</h5>
                                </div>
                                <div class="card-body p-4">
                                    <% let allHostReviews=[]; myListings.forEach(l=> {
                                        if(l.reviews && l.reviews.length > 0) {
                                        l.reviews.forEach(r => {
                                        // We need author? populated? In 'renderDashboard', we populated 'reviews'.
                                        // But reviews usually ref 'author'. We did NOT populate 'reviews.author'.
                                        // So author will be an ID.
                                        allHostReviews.push({ ...r.toObject(), listingTitle: l.title });
                                        });
                                        }
                                        });
                                        // We can't show Author Name if not populated. We'll show Rating and Comment.
                                        %>
                                        <% if(allHostReviews.length> 0) { %>
                                            <div class="row">
                                                <% for(let r of allHostReviews) { %>
                                                    <div class="col-md-6 mb-3">
                                                        <div class="border rounded-3 p-3 h-100">
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <small class="text-muted fw-bold">
                                                                    <%= r.listingTitle %>
                                                                </small>
                                                                <div class="text-warning small">
                                                                    <% for(let i=0; i<r.rating; i++) { %><i
                                                                            class="fa-solid fa-star"></i>
                                                                        <% } %>
                                                                </div>
                                                            </div>
                                                            <p class="mb-0 small text-dark">
                                                                <%= r.comment %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <% } %>
                                            </div>
                                            <% } else { %>
                                                <p class="text-muted text-center py-3">No reviews received yet.</p>
                                                <% } %>
                                </div>
                            </div>

                            <style>
                                .card-hover {
                                    transition: transform 0.2s;
                                    cursor: pointer;
                                }

                                .card-hover:hover {
                                    transform: translateY(-5px);
                                }

                                .scroll-mt {
                                    scroll-margin-top: 100px;
                                }
                            </style>

                            <% } else { %>
                                <div class="alert alert-info">Analytics data unavailable.</div>
                                <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Profile Modal -->
    <div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 shadow border-0">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold">Edit Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form action="/profile?_method=PUT" method="POST" enctype="multipart/form-data">
                        <div class="mb-4 text-center">
                            <div class="mx-auto mb-3 position-relative" style="width: 100px; height: 100px;">
                                <img src="<%= (user.image && user.image.url) ? user.image.url : 'https://images.unsplash.com/photo-1511367461989-f85a21fda167?q=80&w=2831&auto=format&fit=crop' %>"
                                    class="rounded-circle w-100 h-100 border object-fit-cover shadow-sm">
                                <label
                                    class="position-absolute bottom-0 end-0 bg-white rounded-circle shadow-sm p-2 border"
                                    style="cursor: pointer; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-camera text-secondary small"></i>
                                    <input type="file" name="image" class="d-none">
                                </label>
                            </div>
                            <small class="text-muted">Click icon to change</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Bio</label>
                            <textarea class="form-control rounded-4 bg-light border-0" name="bio" rows="3"
                                placeholder="Tell us about yourself..."><%= user.bio %></textarea>
                        </div>
                        <button class="btn btn-danger w-100 rounded-pill fw-bold py-2 mt-2"
                            style="background-color: #FF385C; border: none;">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        <% if (typeof hostStats !== 'undefined') { %>
            document.addEventListener('DOMContentLoaded', function () {
                const ctx = document.getElementById('analyticsGraph');

                if (ctx) {
                    // Read data from attribute to avoid EJS syntax issues in JS
                    const rawEarnings = ctx.getAttribute('data-earnings');
                    const rawBookings = ctx.getAttribute('data-bookings');

                    const earningsData = JSON.parse(rawEarnings || '[]');
                    const bookingsData = JSON.parse(rawBookings || '[]');

                    const myChart = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                            datasets: [
                                {
                                    label: 'Earnings (₹)',
                                    data: earningsData,
                                    backgroundColor: 'rgba(255, 56, 92, 0.8)',
                                    borderRadius: 4,
                                    order: 2,
                                    yAxisID: 'y'
                                },
                                {
                                    label: 'Bookings',
                                    data: bookingsData,
                                    type: 'line',
                                    borderColor: '#008489',
                                    backgroundColor: 'rgba(0, 132, 137, 0.1)',
                                    borderWidth: 2,
                                    pointBackgroundColor: '#fff',
                                    pointBorderColor: '#008489',
                                    pointRadius: 4,
                                    tension: 0.4,
                                    fill: true,
                                    order: 1,
                                    yAxisID: 'y1'
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: {
                                mode: 'index',
                                intersect: false,
                            },
                            plugins: {
                                legend: {
                                    display: true,
                                    position: 'top',
                                    labels: {
                                        usePointStyle: true,
                                        boxWidth: 8
                                    }
                                },
                                tooltip: {
                                    padding: 10,
                                    cornerRadius: 8,
                                    backgroundColor: 'rgba(0,0,0,0.8)'
                                }
                            },
                            scales: {
                                y: {
                                    type: 'linear',
                                    display: true,
                                    position: 'left',
                                    beginAtZero: true,
                                    grid: { display: true, borderDash: [5, 5] },
                                    title: { display: true, text: 'Earnings (₹)' }
                                },
                                y1: {
                                    type: 'linear',
                                    display: true,
                                    position: 'right',
                                    beginAtZero: true,
                                    grid: { display: false },
                                    title: { display: true, text: 'Bookings' }
                                },
                                x: {
                                    grid: { display: false }
                                }
                            }
                        }
                    });

                    // Resize chart when Analytics tab is shown
                    const tabEl = document.querySelector('button[data-bs-target="#analytics"]');
                    if (tabEl) {
                        tabEl.addEventListener('shown.bs.tab', event => {
                            console.log("Analytics tab shown, resizing chart...");
                            myChart.resize();
                        });
                    }
                } else {
                    console.error("Canvas element 'earningsChart' not found!");
                }
            });
        <% } %>
    </script>

