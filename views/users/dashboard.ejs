        }

        .listing-card-dashboard {
            transition: transform 0.2s;
            border-radius: 15px !important;
            overflow: hidden;
        }

        .listing-card-dashboard:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15) !important;
        }

        .object-fit-cover {
            object-fit: cover;
        }
    </style>