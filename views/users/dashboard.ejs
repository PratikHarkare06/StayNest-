<% layout("/layouts/boilerplate") %>

    <!-- Success Celebration Logic -->
    <% if(typeof success !== 'undefined' || (typeof query !== 'undefined' && query.success === 'booking')) { %>
        <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Confetti Celebration
                const duration = 3 * 1000;
                const animationEnd = Date.now() + duration;
                const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 9999 };

                const randomInRange = (min, max) => Math.random() * (max - min) + min;

                const interval = setInterval(function() {
                    const timeLeft = animationEnd - Date.now();

                    if (timeLeft <= 0) {
                        return clearInterval(interval);
                    }

                    const particleCount = 50 * (timeLeft / duration);
                    // since particles fall down, start a bit higher than random
                    confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
                    confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
                }, 250);

                // Show Success Toast
                if (typeof toastSuccess === 'function') {
                    toastSuccess('Pack your bags!', 'Your booking has been confirmed. You can see it in your trips below.');
                }
            });
        </script>
    <% } %>

    <div class="container-fluid dashboard-container">
        <div class="row">
            <!-- Sidebar / Profile Section -->
            <div class="col-lg-3 col-md-4 mb-4">
                <div class="card border-0 shadow-sm profile-card sticky-top"
                    style="top: 100px; border-radius: 20px; overflow: hidden;">
                    <div class="card-header bg-transparent border-0 text-center pt-5 pb-4"
                        style="background: linear-gradient(135deg, #FF385C 0%, #E61E4D 100%);">
                        <div class="profile-img-wrapper mb-3 mx-auto">
                            <img src="<%= user.image && user.image.url ? user.image.url : 'https://images.unsplash.com/photo-1511367461989-f85a21fda167?q=80&w=2831&auto=format&fit=crop' %>"
                                alt="profile-image" class="rounded-circle profile-img border border-4 border-white">
                        </div>
                        <h4 class="text-white fw-bold mb-1">
                            @<%= user.username %>
                            <% if(user.isVerified) { %>
                                <i class="fa-solid fa-circle-check text-info ms-1" style="font-size: 0.9rem;" title="Verified Identity"></i>
                            <% } %>
                        </h4>
                        <p class="text-white-50 small mb-0">
                            <%= user.email %>
                        </p>
                    </div>
                    <div class="card-body p-4">
                        <% if(!user.isVerified) { %>
                            <div class="alert alert-warning border-0 rounded-4 py-2 px-3 small mb-4 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <span>Get verified to build trust with hosts.</span>
                            </div>
                        <% } %>

                        <div class="d-flex justify-content-around text-center mb-4">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">
                                    <%= myBookings.length %>
                                </h5>
                                <small class="text-muted">Trips</small>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">
                                    <%= myListings.length %>
                                </h5>
                                <small class="text-muted">Listings</small>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">
                                    <%= user.wishlist.length %>
                                </h5>
                                <small class="text-muted">Wishlist</small>
                            </div>
                        </div>
                        <hr class="text-muted opacity-25">
                        <p class="text-muted small mb-4">
                            <i class="fa-solid fa-quote-left text-danger me-2"></i>
                            <%= user.bio || "No bio added yet. Tell the world a bit about yourself!" %>
                        </p>
                        
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-dark rounded-pill btn-sm" data-bs-toggle="modal"
                                data-bs-target="#editProfileModal">Edit Profile</button>
                            
                            <% if(!user.isVerified) { %>
                                <button class="btn btn-dark rounded-pill btn-sm" data-bs-toggle="modal"
                                    data-bs-target="#verifyIdModal">
                                    <i class="fa-solid fa-shield-halved me-1"></i> Verify Identity
                                </button>
                            <% } else { %>
                                <div class="text-center py-1">
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">
                                        <i class="fa-solid fa-check-double me-1"></i> ID Verified
                                    </span>
                                </div>
                            <% } %>
                        </div>

                        <p class="text-center mt-3 text-muted mb-0" style="font-size: 0.8rem;">Member since <%= new
                                Date(user.createdAt).getFullYear() %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Verify ID Modal -->
            <div class="modal fade" id="verifyIdModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4 border-0 shadow">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="fw-bold">Verify Your Identity</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <p class="text-muted small mb-4">Upload a clear photo of your government-issued ID (Passport, Driving License, or Aadhaar). This remains private and helps keep StayNest safe.</p>
                            <form action="/dashboard/verify-id" method="POST" enctype="multipart/form-data">
                                <div class="mb-4">
                                    <label class="form-label fw-bold small text-uppercase">Identification Document</label>
                                    <input type="file" name="idDocument" class="form-control rounded-3" required>
                                </div>
                                <button type="submit" class="btn btn-danger w-100 rounded-pill fw-bold py-2 shadow-sm" style="background:#FF385C;">
                                    Submit for Verification
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content Section -->
            <div class="col-lg-9 col-md-8">
                <!-- Tabs Navigation -->
                <ul class="nav nav-pills mb-4 nav-justified bg-white p-2 rounded-pill shadow-sm" id="dashboardTabs"
                    role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill fw-bold" id="bookings-tab" data-bs-toggle="pill"
                            data-bs-target="#bookings" type="button" role="tab" aria-selected="true">
                            <i class="fa-solid fa-suitcase-rolling me-2"></i>My Trips
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-bold" id="listings-tab" data-bs-toggle="pill"
                            data-bs-target="#listings" type="button" role="tab" aria-selected="false">
                            <i class="fa-solid fa-house-user me-2"></i>My Properties
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-bold" id="wishlist-tab" data-bs-toggle="pill"
                            data-bs-target="#wishlist" type="button" role="tab" aria-selected="false">
                            <i class="fa-solid fa-heart me-2"></i>Wishlist
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-bold" id="analytics-tab" data-bs-toggle="pill"
                            data-bs-target="#analytics" type="button" role="tab" aria-selected="false">
                            <i class="fa-solid fa-chart-line me-2"></i>Analytics
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="dashboardTabsContent">

                    <!-- My Bookings Tab -->
                    <div class="tab-pane fade show active" id="bookings" role="tabpanel">
                        <% if(myBookings && myBookings.length > 0) { %>

                        <style>
                        .trip-card {
                          border-radius: 20px !important;
                          overflow: hidden;
                          transition: transform 0.22s, box-shadow 0.22s;
                          border: 1px solid #ebebeb !important;
                          background: #fff;
                        }
                        .trip-card:hover { transform: translateY(-4px); box-shadow: 0 12px 36px rgba(0,0,0,0.08) !important; }

                        .trip-card-img { width: 140px; min-height: 140px; object-fit: cover; flex-shrink: 0; }

                        @media(max-width:576px) { .trip-card-img { width: 100px; } }

                        .trip-status-upcoming { background:#e6f9f0; color:#0a7a45; }
                        .trip-status-active    { background:#fff3cd; color:#856404; }
                        .trip-status-completed { background:#f0f0f0; color:#555; }
                        .trip-status-cancelled { background:#fde8ec; color:#C13515; }

                        .countdown-chip {
                          display: inline-flex; align-items: center; gap: 0.35rem;
                          background: #fff8f0; border: 1px solid #fde0c4;
                          border-radius: 20px; padding: 0.25rem 0.75rem;
                          font-size: 0.78rem; font-weight: 600; color: #c45000;
                        }
                        </style>

                            <div class="d-flex justify-content-between align-items-center mb-4 px-1">
                              <h5 class="fw-bold mb-0 text-dark"><%= myBookings.length %> Trip<%= myBookings.length !== 1 ? 's' : '' %></h5>
                              <a href="/listings" class="btn btn-outline-dark rounded-pill btn-sm px-4 fw-bold">
                                <i class="fa-solid fa-plus me-1"></i> New Trip
                              </a>
                            </div>

                            <div class="d-flex flex-column gap-3">
                                <% const now = new Date(); %>
                                <% for(let booking of myBookings.sort((a,b) => new Date(b.checkIn) - new Date(a.checkIn))) { %>
                                <%
                                  const ci = new Date(booking.checkIn);
                                  const co = new Date(booking.checkOut);
                                  const nights = Math.ceil(Math.abs(co - ci) / 86400000);
                                  const daysUntil = Math.ceil((ci - now) / 86400000);
                                  let tripState = 'completed';
                                  if (booking.status === 'Cancelled') tripState = 'cancelled';
                                  else if (now >= ci && now <= co)     tripState = 'active';
                                  else if (now < ci)                   tripState = 'upcoming';
                                %>

                                <div class="card trip-card border-0 shadow-sm">
                                    <div class="row g-0">
                                        <!-- Image -->
                                        <div class="col-auto">
                                            <img src="<%= booking.listing.image ? booking.listing.image.url : '/images/placeholder.jpg' %>"
                                                 class="trip-card-img rounded-start h-100"
                                                 alt="<%= booking.listing.title %>"
                                                 onerror="this.src='/images/placeholder.jpg'">
                                        </div>

                                        <!-- Content -->
                                        <div class="col">
                                            <div class="card-body py-3 px-4 d-flex flex-column h-100 justify-content-between">
                                                <div>
                                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                                        <h6 class="card-title fw-bold mb-0 text-truncate" style="max-width:280px;">
                                                            <%= booking.listing.title %>
                                                        </h6>
                                                        <span class="badge rounded-pill px-3 py-1 trip-status-<%= tripState %> flex-shrink-0 ms-2">
                                                            <% if(tripState === 'upcoming')  { %><i class="fa-regular fa-clock me-1"></i>Upcoming
                                                            <% } else if(tripState === 'active') { %><i class="fa-solid fa-map-location-dot me-1"></i>Active
                                                            <% } else if(tripState === 'cancelled') { %><i class="fa-solid fa-ban me-1"></i>Cancelled
                                                            <% } else { %><i class="fa-solid fa-check me-1"></i>Completed<% } %>
                                                        </span>
                                                    </div>

                                                    <p class="text-muted small mb-2">
                                                        <i class="fa-solid fa-location-dot me-1"></i><%= booking.listing.location %>, <%= booking.listing.country %>
                                                    </p>

                                                    <!-- Dates Grid -->
                                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                                        <div class="bg-light rounded-3 px-3 py-1" style="min-width: 100px;">
                                                            <div class="text-muted" style="font-size:0.65rem;font-weight:700;text-transform:uppercase;">Check-in</div>
                                                            <div class="fw-bold" style="font-size:0.85rem;"><%= ci.toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %></div>
                                                        </div>
                                                        <div class="bg-light rounded-3 px-3 py-1" style="min-width: 100px;">
                                                            <div class="text-muted" style="font-size:0.65rem;font-weight:700;text-transform:uppercase;">Check-out</div>
                                                            <div class="fw-bold" style="font-size:0.85rem;"><%= co.toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %></div>
                                                        </div>
                                                        <div class="bg-light rounded-3 px-3 py-1">
                                                            <div class="text-muted" style="font-size:0.65rem;font-weight:700;text-transform:uppercase;">Nights</div>
                                                            <div class="fw-bold text-center" style="font-size:0.85rem;"><%= nights %></div>
                                                        </div>
                                                    </div>

                                                    <!-- Insights -->
                                                    <% if (tripState === 'upcoming' && daysUntil > 0) { %>
                                                    <div class="countdown-chip mb-2">
                                                        <i class="fa-solid fa-fire"></i>
                                                        <% if(daysUntil === 1) { %>Tomorrow!
                                                        <% } else { %><%= daysUntil %> days to go<% } %>
                                                    </div>
                                                    <% } else if (tripState === 'active') { %>
                                                    <div class="countdown-chip mb-2" style="background:#e6f9f0;border-color:#a8e6c8;color:#0a7a45;">
                                                        <i class="fa-solid fa-circle-dot"></i> Happening now
                                                    </div>
                                                    <% } %>
                                                </div>

                                                <!-- Actions -->
                                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-1">
                                                    <div>
                                                        <span class="fw-bold text-dark">&#8377;<%= booking.totalPrice.toLocaleString("en-IN") %></span>
                                                        <span class="text-muted small ms-1">total</span>
                                                    </div>
                                                    <div class="d-flex gap-2">
                                                        <a href="/listings/<%= booking.listing._id %>" class="btn btn-sm btn-light rounded-pill px-3 border fw-semibold">
                                                            Listing
                                                        </a>
                                                        <% if(tripState === 'upcoming') { %>
                                                        <form method="POST" action="/listings/<%= booking.listing._id %>/bookings/<%= booking._id %>/cancel?_method=DELETE"
                                                              onsubmit="return confirm('Cancel your trip to <%= booking.listing.title %>?')">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                                                                Cancel
                                                            </button>
                                                        </form>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                            </div>

                        <% } else { %>
                            <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
                                <i class="fa-solid fa-suitcase-rolling fa-3x text-muted mb-3 opacity-25"></i>
                                <h5 class="fw-bold text-dark">No trips booked yet</h5>
                                <p class="text-muted mb-4">Time to dust off your bags and start planning your next escape.</p>
                                <a href="/listings" class="btn btn-danger rounded-pill px-4 fw-bold" style="background:#FF385C;border:none;">
                                    Explore Stays
                                </a>
                            </div>
                        <% } %>
                    </div>

                    <!-- My Listings Tab -->
                    <div class="tab-pane fade" id="listings" role="tabpanel">
                        <% if(myListings && myListings.length> 0) { %>
                            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                                <% for(let listing of myListings) { %>
                                    <div class="col">
                                        <div
                                            class="card h-100 border-0 shadow-sm listing-card-dashboard position-relative">
                                            <div class="position-relative">
                                                <img src="/images/placeholder.jpg" data-src="<%= listing.image.url %>"
                                                    class="card-img-top rounded-top lazy-load" alt="listing_image"
                                                    style="height: 200px; object-fit: cover;">
                                                <div class="card-img-overlay p-2 text-end">
                                                    <span class="badge bg-dark bg-opacity-75">Owned</span>
                                                </div>
                                            </div>
                                            <div class="card-body p-3 d-flex flex-column">
                                                <h6 class="card-title fw-bold text-truncate">
                                                    <%= listing.title %>
                                                </h6>
                                                <p class="card-text text-muted small mb-2">
                                                    <%= listing.location %>
                                                </p>
                                                <!-- Whole card link -->
                                                <a href="/listings/<%= listing._id %>" class="stretched-link"></a>

                                                <div class="mt-auto d-flex justify-content-end align-items-center pt-2">
                                                    <!-- Dropdown must be above the stretched link -->
                                                    <div class="dropdown" style="position: relative; z-index: 2;">
                                                        <button class="btn btn-sm btn-light rounded-circle border"
                                                            type="button" data-bs-toggle="dropdown">
                                                            <i class="fa-solid fa-ellipsis-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                                                            <li><a class="dropdown-item"
                                                                    href="/listings/<%= listing._id %>/edit"><i
                                                                        class="fa-solid fa-pen me-2 small"></i>Edit</a>
                                                            </li>
                                                            <li>
                                                                <form method="POST"
                                                                    action="/listings/<%= listing._id %>?_method=DELETE"
                                                                    class="d-inline p-0">
                                                                    <button class="dropdown-item text-danger"><i
                                                                            class="fa-solid fa-trash me-2 small"></i>Delete</button>
                                                                </form>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                                        <!-- Add New Listing Card -->
                                        <div class="col">
                                            <a href="/listings/new" class="text-decoration-none">
                                                <div class="card h-100 border-2 border-dashed border-secondary bg-transparent d-flex align-items-center justify-content-center text-center p-4"
                                                    style="min-height: 300px; opacity: 0.6; transition: all 0.3s;">
                                                    <div>
                                                        <div class="mb-3">
                                                            <i class="fa-solid fa-plus fa-3x text-secondary"></i>
                                                        </div>
                                                        <h6 class="fw-bold text-secondary">List a New Property</h6>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                            </div>
                            <% } else { %>
                                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                                    <i class="fa-solid fa-house-chimney-crack fa-3x text-muted mb-3 opacity-50"></i>
                                    <h5 class="fw-bold text-muted">No properties listed</h5>
                                    <p class="text-muted mb-4">Earn extra income by hosting your home using our
                                        platform.</p>
                                    <a href="/listings/new" class="btn btn-primary rounded-pill px-4 shadow-sm">Airbnb
                                        your home</a>
                                </div>
                                <% } %>
                    </div>

                    <!-- Wishlist Tab -->
                    <div class="tab-pane fade" id="wishlist" role="tabpanel">
                        <% if(user.wishlist && user.wishlist.length> 0) { %>
                            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                                <% for(let listing of user.wishlist) { %>
                                    <div class="col">
                                        <div class="card h-100 border-0 shadow-sm listing-card-dashboard">
                                            <div class="position-relative">
                                                <img src="/images/placeholder.jpg" data-src="<%= listing.image.url %>"
                                                    class="card-img-top rounded-top lazy-load" alt="listing_image"
                                                    style="height: 200px; object-fit: cover;">
                                                <form action="/users/wishlist/<%= listing._id %>" method="POST"
                                                    class="position-absolute top-0 end-0 p-2 wishlist-form">
                                                    <button
                                                        class="btn btn-light btn-sm rounded-circle shadow-sm text-danger border-0">
                                                        <i class="fa-solid fa-heart"></i>
                                                    </button>
                                                </form>
                                            </div>
                                            <div class="card-body p-3">
                                                <h6 class="card-title fw-bold text-truncate">
                                                    <%= listing.title %>
                                                </h6>
                                                <p class="card-text text-muted small mb-0">
                                                    <%= listing.location %>
                                                </p>
                                                <div class="mt-2">
                                                    <span class="fw-bold">&#8377; <%=
                                                            listing.price.toLocaleString("en-IN") %></span>
                                                    <small>night</small>
                                                </div>
                                                <a href="/listings/<%= listing._id %>" class="stretched-link"></a>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                            <% } else { %>
                                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                                    <i class="fa-regular fa-heart fa-3x text-muted mb-3 opacity-50"></i>
                                    <h5 class="fw-bold text-muted">Your wishlist is empty</h5>
                                    <p class="text-muted mb-4">Save properties you love to find them easily later.</p>
                                    <a href="/listings" class="btn btn-outline-primary rounded-pill px-4">Explore
                                        listings</a>
                                </div>
                                <% } %>
                    </div>

                    <!-- Analytics Tab -->
                    <div class="tab-pane fade" id="analytics" role="tabpanel">
                        <% if(typeof hostStats !== 'undefined' ) { %>
                            <!-- Host Header Stats -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: #fff;">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;font-size:1.2rem;">
                                                <i class="fa-solid fa-indian-rupee-sign"></i>
                                            </div>
                                            <div>
                                                <div class="text-muted small fw-bold text-uppercase" style="letter-spacing:0.05em;">Earnings</div>
                                                <h4 class="fw-bold mb-0">₹<%= hostStats.totalEarnings.toLocaleString("en-IN") %></h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: #fff;">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;font-size:1.2rem;">
                                                <i class="fa-solid fa-calendar-check"></i>
                                            </div>
                                            <div>
                                                <div class="text-muted small fw-bold text-uppercase" style="letter-spacing:0.05em;">Bookings</div>
                                                <h4 class="fw-bold mb-0"><%= hostStats.totalBookings %></h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: #fff;">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;font-size:1.2rem;">
                                                <i class="fa-solid fa-star"></i>
                                            </div>
                                            <div>
                                                <div class="text-muted small fw-bold text-uppercase" style="letter-spacing:0.05em;">Rating</div>
                                                <h4 class="fw-bold mb-0"><%= hostStats.avgRating %><span class="text-muted small">/5</span></h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Performance Chart -->
                            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                                <h6 class="fw-bold mb-4">Performance Overview (<%= new Date().getFullYear() %>)</h6>
                                <div style="height: 300px;">
                                    <canvas id="hostChart" 
                                            data-earnings='<%- JSON.stringify(hostStats.earningsByMonth) %>' 
                                            data-bookings='<%- JSON.stringify(hostStats.bookingsByMonth) %>'></canvas>
                                </div>
                            </div>

                            <!-- Reservations Table -->
                            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold mb-0">Incoming Reservations</h6>
                                    <span class="badge bg-light text-dark border fw-semibold">View all</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" style="font-size:0.9rem;">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="border-0 ps-4">Guest</th>
                                                <th class="border-0">Property</th>
                                                <th class="border-0">Check-in</th>
                                                <th class="border-0">Check-out</th>
                                                <th class="border-0">Payout</th>
                                                <th class="border-0 pe-4">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if(hostBookings && hostBookings.length > 0) { %>
                                                <% for(let hb of hostBookings.reverse()) { %>
                                                <% const hostListing = myListings.find(l => l._id.equals(hb.listing)); %>
                                                <tr>
                                                    <td class="ps-4">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width:30px;height:30px;font-size:0.75rem;">
                                                                <%= hb.user ? hb.user.username[0].toUpperCase() : '?' %>
                                                            </div>
                                                            <span class="fw-semibold"><%= hb.user ? hb.user.username : 'Guest' %></span>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="text-truncate d-block" style="max-width: 140px;" title="<%= hostListing ? hostListing.title : '' %>">
                                                            <%= hostListing ? hostListing.title : 'Deleted' %>
                                                        </span>
                                                    </td>
                                                    <td><%= new Date(hb.checkIn).toLocaleDateString('en-IN', {day:'numeric', month:'short'}) %></td>
                                                    <td><%= new Date(hb.checkOut).toLocaleDateString('en-IN', {day:'numeric', month:'short'}) %></td>
                                                    <td class="fw-bold">₹<%= hb.totalPrice.toLocaleString("en-IN") %></td>
                                                    <td class="pe-4">
                                                        <span class="badge rounded-pill px-3 py-1 <%= hb.status === 'Confirmed' ? 'bg-success' : 'bg-warning' %> bg-opacity-10 text-<%= hb.status === 'Confirmed' ? 'success' : 'warning' %>">
                                                            <%= hb.status %>
                                                        </span>
                                                    </td>
                                                </tr>
                                                <% } %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6" class="text-center py-5 text-muted">
                                                        <i class="fa-solid fa-calendar-day fa-2x mb-2 opacity-25"></i><br>
                                                        No reservations yet
                                                    </td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="alert alert-info rounded-4 border-0">Host analytics are only available for properties you own.</div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Profile Modal (moved down for clean tab section) -->
    <!-- Edit Profile Modal -->
    <div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="editProfileModalLabel">Edit Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form action="/dashboard/edit-profile" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="username" class="form-label fw-bold">Display Name</label>
                            <input type="text" class="form-control rounded-3" id="username" name="username" value="<%= user.username %>" required>
                        </div>
                        <div class="mb-3">
                            <label for="bio" class="form-label fw-bold">Bio</label>
                            <textarea class="form-control rounded-3" id="bio" name="bio" rows="3" placeholder="Tell us a little about yourself..."><%= user.bio || '' %></textarea>
                        </div>
                        <div class="mb-4">
                            <label for="image" class="form-label fw-bold">Profile Picture</label>
                            <input class="form-control rounded-3" type="file" id="image" name="image" accept="image/*">
                            <div class="form-text">Choose a square image for best results.</div>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-danger rounded-pill py-2 fw-bold" style="background-color: #ff385c; border: none;">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const chartEl = document.getElementById('hostChart');
            if (!chartEl) return;

            const earnings = JSON.parse(chartEl.dataset.earnings || '[]');
            const bookings = JSON.parse(chartEl.dataset.bookings || '[]');

            new Chart(chartEl, {
                type: 'bar',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                    datasets: [
                        {
                            label: 'Earnings (₹)',
                            data: earnings,
                            backgroundColor: 'rgba(255, 56, 92, 0.8)',
                            borderRadius: 6,
                            order: 2,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Bookings',
                            data: bookings,
                            type: 'line',
                            borderColor: '#008489',
                            borderWidth: 3,
                            pointRadius: 4,
                            pointBackgroundColor: '#fff',
                            tension: 0.4,
                            order: 1,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { position: 'left', beginAtZero: true, grid: { borderDash: [5, 5] }, ticks: { font: { size: 10 } } },
                        y1: { position: 'right', beginAtZero: true, grid: { display: false }, ticks: { font: { size: 10 } } },
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });
        });
    </script>

