<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5 pb-5">
    <div class="row align-items-center mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <a href="/messages" class="btn btn-outline-dark rounded-circle me-3 border-0"><i class="fa-solid fa-chevron-left"></i></a>
            <div class="d-flex align-items-center flex-grow-1">
                <img src="<%= partner.image.url %>" class="rounded-circle object-fit-cover me-3 shadow-sm" style="width: 48px; height: 48px;">
                <h5 class="fw-bold mb-0"><%= partner.username %></h5>
            </div>
            <a href="/listings" class="text-dark small fw-bold text-decoration-none bg-light px-3 py-2 rounded-pill shadow-sm">View Listings</a>
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden mx-auto" style="height: 65vh; max-width: 900px; display: flex; flex-direction: column;">
        
        <!-- Chat Area -->
        <div id="chat-box" class="card-body bg-light p-4 overflow-auto flex-grow-1" style="display: flex; flex-direction: column;">
            <% if (messages.length === 0) { %>
                <div class="text-center my-auto">
                    <p class="text-muted fw-bold">This is the start of your conversation with <%= partner.username %></p>
                </div>
            <% } else { %>
                <% for (let msg of messages) { %>
                    <% const isMe = msg.sender.equals(currUser._id); %>
                    <div class="message-wrapper d-flex flex-column align-items-<%= isMe ? 'end' : 'start' %> mb-3 animate__animated animate__fadeInUp animate__faster">
                        <div class="message-bubble py-2 px-3 rounded-4 shadow-sm <%= isMe ? 'bg-dark text-white' : 'bg-white border text-dark' %>" style="max-width: 75%; overflow-wrap: break-word;">
                            <%= msg.content %>
                        </div>
                        <small class="text-muted mt-1" style="font-size: 0.65rem;"><%= new Date(msg.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small>
                    </div>
                <% } %>
            <% } %>
        </div>

        <!-- Input Box -->
        <div class="card-footer bg-white border-top p-3 d-flex align-items-center gap-2 m-2 rounded-pill shadow-sm">
            <input type="text" id="chat-input" class="form-control border-0 bg-transparent shadow-none" placeholder="Type a message..." style="box-shadow: none !important; outline: none !important;">
            <button id="send-btn" class="btn btn-dark rounded-circle d-flex align-items-center justify-content-center p-0 shadow" style="width: 40px; height: 40px; min-width: 40px;">
                <i class="fa-solid fa-paper-plane text-white fs-6"></i>
            </button>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const socket = io(); // Connects to the host automatically
        
        const currUserId = "<%= currUser._id %>";
        const partnerId = "<%= partner._id %>";
        
        socket.emit("register_user", currUserId); // Bind User ID to room
        
        const chatBox = document.getElementById("chat-box");
        const chatInput = document.getElementById("chat-input");
        const sendBtn = document.getElementById("send-btn");
        
        // Auto-scroll to bottom of chat
        function scrollToBottom() {
            chatBox.scrollTop = chatBox.scrollHeight;
        }
        scrollToBottom();

        // Send Message
        function sendMessage() {
            const txt = chatInput.value.trim();
            if(!txt) return;

            const payload = {
                senderId: currUserId,
                receiverId: partnerId,
                content: txt
            };

            socket.emit("send_message", payload);
            chatInput.value = "";
            chatInput.focus();
        }

        sendBtn.addEventListener("click", sendMessage);
        chatInput.addEventListener("keypress", (e) => {
            if(e.key === "Enter") sendMessage();
        });

        // Listen for incoming messages
        socket.on("new_message", (msg) => {
            // Only render if it belongs to this active conversation thread
            if( (msg.sender._id === partnerId && msg.receiver === currUserId) || 
                (msg.sender._id === currUserId && msg.receiver === partnerId) ) {
                
                const isMe = (msg.sender._id === currUserId);
                
                const msgWrapper = document.createElement("div");
                msgWrapper.className = `message-wrapper d-flex flex-column align-items-${isMe ? 'end' : 'start'} mb-3`;
                
                msgWrapper.innerHTML = `
                    <div class="message-bubble py-2 px-3 rounded-4 shadow-sm ${isMe ? 'bg-dark text-white' : 'bg-white border text-dark'}" style="max-width: 75%; overflow-wrap: break-word;">
                        ${msg.content}
                    </div>
                    <small class="text-muted mt-1" style="font-size: 0.65rem;">Now</small>
                `;
                
                // If it was the empty state text, remove it
                if(chatBox.querySelector('.text-muted.fw-bold')) {
                    chatBox.innerHTML = '';
                }
                
                chatBox.appendChild(msgWrapper);
                scrollToBottom();
            }
        });
    });
</script>
