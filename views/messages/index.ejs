<% layout("/layouts/boilerplate") %>

<div class="container mt-5 mb-5 pb-5">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center border-bottom pb-3">
            <h1 class="fw-bold mb-0">Messages</h1>
            <span class="badge bg-danger rounded-pill px-3 py-2"><%= conversations.filter(c => c.unread).length %> Unread</span>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8 mx-auto">
            <% if (conversations.length === 0) { %>
                <div class="text-center mt-5 p-5 bg-white rounded-4 shadow-sm border border-secondary border-opacity-10">
                    <i class="fa-regular fa-comments fa-4x text-muted opacity-25 mb-3"></i>
                    <h5 class="fw-bold text-dark">No messages yet</h5>
                    <p class="text-muted">When you contact a host or a guest contacts you, it'll show up here.</p>
                    <a href="/listings" class="btn btn-outline-dark rounded-pill fw-bold mt-2">Explore experiences</a>
                </div>
            <% } else { %>
                <ul class="list-group list-group-flush rounded-4 shadow-sm border border-secondary border-opacity-10">
                    <% for(let conv of conversations) { %>
                        <a href="/messages/<%= conv.user._id %>" class="list-group-item list-group-item-action py-4 px-4 border-bottom hover-bg-light" style="transition: all 0.2s;">
                            <div class="d-flex align-items-center">
                                <div class="position-relative me-3">
                                    <img src="<%= conv.user.image.url %>" class="rounded-circle object-fit-cover shadow-sm" style="width: 56px; height: 56px;">
                                    <% if(conv.unread) { %>
                                        <span class="position-absolute top-0 start-100 translate-middle p-2 bg-danger border border-light rounded-circle">
                                            <span class="visually-hidden">New alerts</span>
                                        </span>
                                    <% } %>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-end mb-1">
                                        <h6 class="fw-bold text-dark mb-0 <%= conv.unread ? 'fs-5' : '' %>">
                                            <%= conv.user.username %>
                                        </h6>
                                        <small class="text-muted"><%= conv.lastMessage.createdAt.toLocaleDateString('en-US', {month: 'short', day: 'numeric'}) %></small>
                                    </div>
                                    <p class="mb-0 text-truncate <%= conv.unread ? 'fw-bold text-dark' : 'text-muted' %>" style="max-width: 90%;">
                                        <% if(conv.lastMessage.sender.equals(currUser._id)) { %>
                                            <span class="text-muted opacity-75">You:</span> 
                                        <% } %>
                                        <%= conv.lastMessage.content %>
                                    </p>
                                </div>
                            </div>
                        </a>
                    <% } %>
                </ul>
            <% } %>
        </div>
    </div>
</div>
