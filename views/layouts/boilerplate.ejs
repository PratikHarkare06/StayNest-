<body data-is-user-logged-in="<%= !!currUser %>">
  <%- include("../includes/navbar.ejs") %>

    <div class="container main-content shadow-sm-on-scroll">
      <%- include("../includes/flash.ejs") %>
        <%-body %>
    </div>

    <!-- Mobile Bottom Navigation -->
    <div class="d-md-none fixed-bottom bg-white border-top shadow-lg py-2"
      style="z-index: 1060; padding-bottom: max(0.5rem, env(safe-area-inset-bottom));">
      <div class="row g-0 text-center">
        <!-- Explore -->
        <div class="col">
          <a href="/listings" class="text-decoration-none d-flex flex-column align-items-center"
            style="color: #ff385c;">
            <i class="fa-solid fa-magnifying-glass mb-1 fs-5"></i>
            <span style="font-size: 0.65rem; font-weight: 600;">Explore</span>
          </a>
        </div>
        <!-- Wishlists -->
        <div class="col">
          <a href="/dashboard" class="text-decoration-none text-secondary d-flex flex-column align-items-center">
            <i class="fa-regular fa-heart mb-1 fs-5"></i>
            <span style="font-size: 0.65rem;">Wishlists</span>
          </a>
        </div>
        <!-- Inbox -->
        <div class="col">
          <a href="/messages" class="text-decoration-none text-secondary d-flex flex-column align-items-center">
            <i class="fa-regular fa-comment mb-1 fs-5"></i>
            <span style="font-size: 0.65rem;">Inbox</span>
          </a>
        </div>
        <!-- Profile -->
        <div class="col">
          <% if(currUser) { %>
            <a href="/dashboard" class="text-decoration-none text-secondary d-flex flex-column align-items-center">
              <div class="rounded-circle bg-dark d-flex align-items-center justify-content-center text-white mb-1"
                style="width: 24px; height: 24px; font-size: 10px;">
                <%= currUser.username[0].toUpperCase() %>
              </div>
              <span style="font-size: 0.65rem;">Profile</span>
            </a>
            <% } else { %>
              <a href="/login" class="text-decoration-none text-secondary d-flex flex-column align-items-center">
                <i class="fa-regular fa-circle-user mb-1 fs-5"></i>
                <span style="font-size: 0.65rem;">Log in</span>
              </a>
              <% } %>
        </div>
      </div>
    </div>

    <%- include("../includes/footer.ejs") %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
      <script src="/js/toast.js"></script>
      <script src="/js/lazyLoad.js"></script>
      <script src="/js/wishlist.js"></script>
      <script src="/js/script.js"></script>

      <!-- Global Real-Time Socket Client -->
      <% if(currUser) { %>
      <script>
      (function() {
        const _socket = io();
        const _ME = "<%= currUser._id %>";

        // Register presence on every page load
        _socket.emit("register_user", _ME);

        // ── Live unread message badge ──────────────────────────────────────────
        _socket.on("new_message", (msg) => {
          // Only if this message is for me and we're NOT on the chat page for this sender
          const isForMe = msg.receiver === _ME;
          const onChatPage = window.location.pathname.includes('/messages/');
          if (isForMe && !onChatPage) {
            const badge = document.getElementById("msg-unread-badge");
            if (badge) badge.style.display = "inline";
            // Mobile bottom nav dot
            const inboxIcon = document.querySelector('.d-md-none a[href="/messages"] i');
            if (inboxIcon) {
              inboxIcon.classList.replace('fa-regular', 'fa-solid');
              inboxIcon.style.color = '#ff385c';
            }
            // Show a toast
            if (window.showToast) {
              window.showToast(
                `💬 ${msg.sender.username || 'New Message'}`,
                msg.content.length > 60 ? msg.content.slice(0,57) + "…" : msg.content,
                "info"
              );
            }
          }
        });

        // ── Live booking availability toast (on listing show pages) ───────────
        const listingDataEl = document.querySelector('[data-listing-id]');
        if (listingDataEl) {
          const listingId = listingDataEl.dataset.listingId;
          _socket.emit("join_listing", listingId);
          _socket.on("listing_booked", (data) => {
            if (window.showToast) {
              window.showToast(
                "⚡ Just booked!",
                "Someone just reserved this place for those dates. Book now to avoid missing out!",
                "warning"
              );
            }
          });
        }

        // Expose for chat page use
        window._globalSocket = _socket;
      })();
      </script>
      <% } %>
      
      <% if(typeof firebaseConfig !== 'undefined') { %>
      <script type="module">
          import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
          import { getMessaging, getToken, onMessage } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-messaging.js";

          const firebaseConfig = JSON.parse('<%- JSON.stringify(firebaseConfig) %>');
          const app = initializeApp(firebaseConfig);
          const messaging = getMessaging(app);

          // Handle incoming foreground notifications
          onMessage(messaging, (payload) => {
            console.log('Message received. ', payload);
            if(window.showToast) {
               window.showToast(payload.notification.title, payload.notification.body);
            } else {
               alert(payload.notification.title + ": " + payload.notification.body);
            }
          });

          // Register for Push Notifications (only if script found a logged-in user signal)
          async function requestPermission() {
              if (document.body.dataset.isUserLoggedIn !== "true") return;
              
              try {
                  const permission = await Notification.requestPermission();
                  if (permission === "granted") {
                      const token = await getToken(messaging, { 
                          vapidKey: firebaseConfig.vapidKey // Use dynamically injected production key
                      });
                      if (token) {
                          fetch("/save-fcm-token", {
                              method: "POST",
                              headers: { "Content-Type": "application/json" },
                              body: JSON.stringify({ fcmToken: token })
                          });
                      }
                  }
              } catch(e) { console.warn("FCM Permission Bypassed:", e); }
          }
          requestPermission();
      </script>
      <% } %>
</body>

</html>