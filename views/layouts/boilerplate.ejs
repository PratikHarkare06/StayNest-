    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then(reg => console.log('StayNest Service Worker: Registered', reg.scope))
          .catch(err => console.log('StayNest Service Worker: Failed', err));
